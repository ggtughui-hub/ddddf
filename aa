local function EnterVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return false end
    if Humanoid.Sit then return true end

    for _, prompt in pairs(vehicle.PrimaryPart:GetDescendants()) do
        if prompt:IsA('ProximityPrompt') then
            fireproximityprompt(prompt)
            task.wait(0)
        end
    end
    local waitCount = 0
    while not Humanoid.Sit and waitCount < 20 do task.wait(0.1); waitCount = waitCount + 1 end
    return Humanoid.Sit
end

local function ExitVehicle()
    if not Humanoid.Sit then return end
    Net.get("exit_seat")
    task.wait(0.3)
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = hrp.CFrame * CFrame.new(0, 2, 3) end
    task.wait(0.2)
end

local function DriveTo(destination, value)
    local vehicle = GetPlayerVehicle()
    if not vehicle then return false end
    if not EnterVehicle(vehicle) then return false end
    Sf:Drive(vehicle, destination, value)
    return true
end

