-- الإحداثيات المطلوبة (مكان الصيد)
local FISHING_SPOTS = {
    Vector3.new(-78.403, 251.635, 134.083),
    -- يمكنك إضافة المزيد من الإحداثيات هنا
    -- Vector3.new(x, y, z),
}

-- ===================== نظام المشي المخصص =====================

-- دالة التحقق من استمرارية التشغيل
local function shouldContinue(value)
    return FishEnabled and Character and Humanoid and HumanoidRootPart
end

-- دالة تعيين سرعة المشي
local function SetWalkSpeed(speed)
    if Character and Humanoid then
        Humanoid.WalkSpeed = speed
        print("⚡ تم تغيير سرعة المشي إلى: " .. speed)
    end
end

-- دالة المشي الذكي مع المسارات
local function WalkTo(destination, value, customSpeed)
    if not Character or not HumanoidRootPart or not Humanoid then
        Running = false
        return false
    end
    
    -- تطبيق السرعة المحددة إذا تم تمريرها
    if customSpeed then
        SetWalkSpeed(customSpeed)
    end
    
    StopWalking = false
    Running = true
    CurrentDestination = destination
    
    print("🚶 جاري التوجه إلى: " .. tostring(destination))
    
    -- إنشاء مسار ذكي
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 45,
        AgentCanClimb = false,
        WaypointSpacing = 4,
        Costs = {
            BlockedNode = 100,
            Water = math.huge,
            DoorArea = 1
        }
    })
    
    -- حساب المسار
    local success = pcall(function()
        path:ComputeAsync(HumanoidRootPart.Position, destination)
    end)
    
    -- إذا فشل حساب المسار، نتحرك مباشرة
    if not success or path.Status ~= Enum.PathStatus.Success then
        Running = false
        print("⚠️ فشل حساب المسار الذكي، استخدام الحركة المباشرة")
        Humanoid:MoveTo(destination)
        
        -- ننتظر حتى الوصول أو انتهاء الوقت
        local timeout = tick() + 10
        while tick() < timeout and shouldContinue(value) do
            if not Character or not HumanoidRootPart then break end
            local distance = (HumanoidRootPart.Position - destination).Magnitude
            if distance < 5 then
                print("✅ تم الوصول إلى الهدف (حركة مباشرة)")
                Running = false
                CurrentDestination = nil
                return true
            end
            task.wait(0.1)
        end
        
        Running = false
        CurrentDestination = nil
        return false
    end
    
    -- الحصول على نقاط المسار
    local waypoints = path:GetWaypoints()
    print("📍 عدد نقاط المسار: " .. #waypoints)
    
    -- التنقل عبر نقاط المسار
    for i, waypoint in pairs(waypoints) do
        if not Character or not HumanoidRootPart or not Humanoid then
            Running = false
            return false
        end
        
        Running = true
        
        if not shouldContinue(value) then
            Running = false
            break
        end
        
        -- قفز عند الحاجة
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end
        
        -- التحرك إلى النقطة التالية
        Humanoid:MoveTo(waypoint.Position)
        
        -- انتظار الوصول إلى النقطة
        local reached = false
        local connection
        connection = Humanoid.MoveToFinished:Connect(function(isReached)
            reached = true
            if connection then
                connection:Disconnect()
            end
        end)
        
        -- مهلة 5 ثواني لكل نقطة
        local timeout = tick() + 5
        while not reached and tick() < timeout and shouldContinue(value) do
            task.wait(0.05)
        end
        
        if not reached and connection then
            connection:Disconnect()
        end
        
        if not shouldContinue(value) then
            break
        end
    end
    
    Running = false
    CurrentDestination = nil
    print("✅ تم الوصول إلى الهدف بنجاح!")
    return true
end

-- دالة التليفورت (الانتقال السريع)
local function TeleportToArea(destination, value, speed)
    if not Character or not HumanoidRootPart then return false end
    
    Running = true
    print("🌀 جاري التليفورت إلى: " .. tostring(destination))
    
    local startPos = HumanoidRootPart.Position
    local distance = (destination - startPos).Magnitude
    local moveSpeed = speed or 16 
    local duration = distance / moveSpeed
    local startTime = tick()
    
    while tick() - startTime < duration and shouldContinue(value) do
        task.wait(0)
        if not Character or not HumanoidRootPart then break end
        
        local alpha = math.min((tick() - startTime) / duration, 1)
        HumanoidRootPart.CFrame = CFrame.new(startPos:Lerp(destination, alpha))
        
        -- إيقاف الفيزياء
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
    
    Running = false
    CurrentDestination = nil
    print("✅ تم التليفورت بنجاح!")
    return true
end

-- ===================== وظائف الصيد =====================

-- جلب أقرب مكان للصيد
local function GetNearestFishingSpot()
    if not Character or not HumanoidRootPart then return nil end
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, spot in pairs(FISHING_SPOTS) do
        local distance = (HumanoidRootPart.Position - spot).Magnitude
        if distance < shortestDistance then
            shortestDistance = distance
            nearest = spot
        end
    end
    
    return nearest, shortestDistance
end

-- بدء الصيد
local function StartFishing()
    print("🎣 بدء الصيد...")
    
    -- محاكاة الصيد (عدل هذا حسب لعبتك)
    local success = false
    local attempts = 0
    
    while attempts < 3 and FishEnabled do
        attempts = attempts + 1
        print("🔄 محاولة الصيد رقم " .. attempts)
        
        -- هنا ضع كود الصيد الخاص باللعبة
        -- مثال: الضغط على زر الصيد
        -- game:GetService("VirtualInputManager"):SendKeyEvent(true, "E", false, game)
        -- task.wait(0.1)
        -- game:GetService("VirtualInputManager"):SendKeyEvent(false, "E", false, game)
        
        -- محاكاة نجاح الصيد
        task.wait(2)
        success = true
        break
    end
    
    if success then
        print("🐟 تم صيد سمكة!")
        return true
    else
        print("❌ فشل الصيد")
        return false
    end
end

-- ===================== حلقة الصيد الرئيسية =====================

local function AutoFishLoop()
    print("🔄 بدء حلقة الصيد التلقائي")
    
    while FishEnabled do
        if not shouldContinue() then
            print("⏹️ إيقاف الحلقة - الشخصية غير موجودة")
            break
        end
        
        -- جلب أقرب مكان للصيد
        local targetSpot, distance = GetNearestFishingSpot()
        
        if not targetSpot then
            print("❌ لا توجد أماكن صيد محددة")
            task.wait(2)
            continue
        end
        
        print("📍 أقرب مكان صيد على بعد: " .. math.floor(distance) .. " متر")
        
        -- إذا كنا بعيدين عن مكان الصيد (أكثر من 10 متر)
        if distance > 10 then
            print("🚶 التوجه إلى مكان الصيد...")
            
            -- استخدام نظام المشي الذكي
            local reached = WalkTo(targetSpot, nil, 20) -- سرعة 20
            
            -- إذا فشل المشي، جرب التليفورت
            if not reached then
                print("🌀 محاولة التليفورت إلى مكان الصيد...")
                reached = TeleportToArea(targetSpot, nil, 30)
            end
            
            if not reached then
                print("⚠️ فشل الوصول إلى مكان الصيد، إعادة المحاولة...")
                task.wait(2)
                continue
            end
        end
        
        -- إذا كنا في مكان الصيد
        if shouldContinue() then
            print("✅ وصلنا إلى مكان الصيد!")
            
            -- بدء الصيد
            local success = StartFishing()
            
            if not success then
                print("⚠️ فشل الصيد، إعادة المحاولة...")
            end
            
            -- انتظار قليل قبل الصيد مرة أخرى
            task.wait(1)
        end
    end
    
    print("⏹️ تم إيقاف Auto Fish")
end

