-- 🚗 VEHICLE MANAGEMENT LOOP
-- ============================================

function ManageVehicle()
    while Config.AutoFarmFishing do
        task.wait(1)
        
        if Config.UseVehicle then
            local vehicleName = VehicleSystem:GetCarFromType(Config.VehicleType)
            
            if not vehicleName then
                VehicleSystem:BuyBikeCrate()
                continue
            end
            
            local existingVehicle = GetSpawnedVehicle()
            
            if not existingVehicle then
                local Checker = GetItemInfo(vehicleName)
                if Checker[2] and not Checker[4] and not Checker[5] then
                    Net.get("toggle_equip_item", tostring(Checker[3]))
                    task.wait(0.1)
                end
            end
            
            -- Auto Repair
            if Config.AutoRepair then
                local currentHP, maxHP, vehicleUID = VehicleSystem:GetVehicleHealth(vehicleName)
                if currentHP and maxHP then
                    local hpDifference = maxHP - currentHP
                    if hpDifference >= 1000 then
                        if VehicleSystem:RepairVehicle(vehicleUID) then
                            task.wait(0.1)
                        end
                    end
                end
            end
            
            -- Lock vehicle
            for _, vehicle in ipairs(Workspace.Vehicles:GetChildren()) do
                if vehicle:GetAttribute('OwnerUserId') == Client.UserId then
                    Net.get("lock_vehicle", vehicle, true)
                    break
                end
            end
        end
        
        task.wait(5)
    end
end

-- ============================================
-- 🎣 AUTO FARM LOOP
-- ============================================

function StartFishingLoop()
    task.spawn(ManageVehicle)
    
    while Config.AutoFarmFishing do
        task.wait(1)
        SellFish()
        task.wait(0.5)
        DoFishing()
        task.wait(2)
    end
end

