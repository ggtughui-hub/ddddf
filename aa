local FishEnabled = false
local FishTask = nil
local CurrentDestination = nil

-- الإحداثيات المطلوبة (مكان الصيد)
local FISHING_SPOTS = {
    Vector3.new(-78.403, 251.635, 134.083),
    -- يمكنك إضافة المزيد من الإحداثيات هنا
    -- Vector3.new(x, y, z),
}

-- ===================== نظام المسارات الذكي =====================
local function ShouldContinue()
    return FishEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

local function WalkTo(destination)
    if not LocalPlayer.Character then 
        print("❌ الشخصية غير موجودة")
        return false
    end
    
    local Character = LocalPlayer.Character
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChild("Humanoid")
    
    if not HumanoidRootPart or not Humanoid then
        print("❌ الأجزاء الأساسية غير موجودة")
        return false
    end
    
    print("🚶 جاري التوجه إلى: " .. tostring(destination))
    CurrentDestination = destination
    
    -- إنشاء مسار ذكي
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 45,
        AgentCanClimb = false,
        WaypointSpacing = 4,
        Costs = {
            BlockedNode = 100,
            Water = math.huge,
            DoorArea = 1
        }
    })
    
    -- حساب المسار
    local success = pcall(function()
        path:ComputeAsync(HumanoidRootPart.Position, destination)
    end)
    
    -- إذا فشل حساب المسار، نتحرك مباشرة
    if not success or path.Status ~= Enum.PathStatus.Success then
        print("⚠️ فشل حساب المسار الذكي، استخدام الحركة المباشرة")
        Humanoid:MoveTo(destination)
        
        -- ننتظر حتى الوصول أو انتهاء الوقت
        local timeout = tick() + 10
        while tick() < timeout and ShouldContinue() do
            local distance = (HumanoidRootPart.Position - destination).Magnitude
            if distance < 5 then
                print("✅ تم الوصول إلى الهدف (حركة مباشرة)")
                CurrentDestination = nil
                return true
            end
            task.wait(0.1)
        end
        
        CurrentDestination = nil
        return false
    end
    
    -- الحصول على نقاط المسار
    local waypoints = path:GetWaypoints()
    print("📍 عدد نقاط المسار: " .. #waypoints)
    
    -- التنقل عبر نقاط المسار
    for i, waypoint in pairs(waypoints) do
        if not ShouldContinue() then
            print("⏹️ تم إيقاف المسار")
            CurrentDestination = nil
            return false
        end
        
        -- قفز عند الحاجة
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end
        
        -- التحرك إلى النقطة التالية
        Humanoid:MoveTo(waypoint.Position)
        
        -- انتظار الوصول إلى النقطة
        local reached = false
        local connection
        
        connection = Humanoid.MoveToFinished:Connect(function(isReached)
            reached = true
            if connection then
                connection:Disconnect()
            end
        end)
        
        -- مهلة 5 ثواني لكل نقطة
        local timeout = tick() + 5
        while not reached and tick() < timeout and ShouldContinue() do
            task.wait(0.05)
        end
        
        if not reached and connection then
            connection:Disconnect()
        end
        
        if not ShouldContinue() then
            CurrentDestination = nil
            return false
        end
    end
    
    print("✅ تم الوصول إلى الهدف بنجاح!")
    CurrentDestination = nil
    return true
end

-- ===================== وظائف الصيد =====================
local function GetNearestFishingSpot()
    if not LocalPlayer.Character then return nil end
    
    local HumanoidRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then return nil end
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, spot in pairs(FISHING_SPOTS) do
        local distance = (HumanoidRootPart.Position - spot).Magnitude
        if distance < shortestDistance then
            shortestDistance = distance
            nearest = spot
        end
    end
    
    return nearest, shortestDistance
end

local function StartFishing()
    print("🎣 بدء الصيد...")
    -- هنا ضع كود الصيد الخاص باللعبة
    -- مثال: محاكاة الصيد
    task.wait(3)
    print("🐟 تم صيد سمكة!")
    return true
end

-- ===================== حلقة الصيد الرئيسية =====================
local function AutoFishLoop()
    print("🔄 بدء حلقة الصيد التلقائي")
    
    while FishEnabled do
        if not ShouldContinue() then
            print("⏹️ إيقاف الحلقة - الشخصية غير موجودة")
            break
        end
        
        -- جلب أقرب مكان للصيد
        local targetSpot, distance = GetNearestFishingSpot()
        
        if not targetSpot then
            print("❌ لا توجد أماكن صيد محددة")
            task.wait(2)
            continue
        end
        
        print("📍 أقرب مكان صيد على بعد: " .. math.floor(distance) .. " متر")
        
        -- إذا كنا بعيدين عن مكان الصيد
        if distance > 10 then
            print("🚶 التوجه إلى مكان الصيد...")
            local reached = WalkTo(targetSpot)
            
            if not reached then
                print("⚠️ فشل الوصول إلى مكان الصيد، إعادة المحاولة...")
                task.wait(2)
                continue
            end
        end
        
        -- إذا كنا في مكان الصيد
        if ShouldContinue() then
            print("✅ وصلنا إلى مكان الصيد!")
            
            -- بدء الصيد
            local success = StartFishing()
            
            if not success then
                print("⚠️ فشل الصيد، إعادة المحاولة...")
            end
            
            -- انتظار قليل قبل الصيد مرة أخرى
            task.wait(1)
        end
    end
    
    print("⏹️ تم إيقاف Auto Fish")
end

