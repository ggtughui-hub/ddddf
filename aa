local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local Window = Fluent:CreateWindow({
    Title = "قائمة Fluent",
    SubTitle = "بواسطتك",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- إنشاء تبويب
local Tab = Window:AddTab({ Title = "الرئيسية", Icon = "home" })

-- متغيرات السكربت
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerName = player.Name
local housingFolder = workspace:FindFirstChild("HousingTile")
local currentHighlight = nil
local espEnabled = false

if not housingFolder then
    warn("لم يتم العثور على مجلد HousingTile!")
end

-- دالة البحث عن البيت
local function findMyHouse()
    if not housingFolder then return nil end
    for _, house in pairs(housingFolder:GetChildren()) do
        local ownerDisplay = house:FindFirstChild("OwnerDisplay")
        if ownerDisplay then
            local billboardGui = ownerDisplay:FindFirstChild("BillboardGui")
            if billboardGui then
                local ownerLabel = billboardGui:FindFirstChild("OwnerLabel")
                if ownerLabel and ownerLabel.Text == playerName then
                    return house
                end
            end
        end
    end
    return nil
end

-- دالة تشغيل/إيقاف ESP
local function toggleESP(state)
    espEnabled = state
    
    if espEnabled then
        local myHouse = findMyHouse()
        if myHouse then
            -- إزالة Highlight قديم
            if currentHighlight then
                currentHighlight:Destroy()
            end
            
            -- إنشاء Highlight جديد
            local highlight = Instance.new("Highlight")
            highlight.Name = "HouseESP"
            highlight.Adornee = myHouse
            highlight.FillColor = Color3.fromRGB(0, 255, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
            highlight.FillTransparency = 0.4
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = myHouse
            currentHighlight = highlight
            
            print("✅ تم تفعيل ESP على بيتك!")
        else
            warn("❌ لم يتم العثور على بيتك!")
        end
    else
        if currentHighlight then
            currentHighlight:Destroy()
            currentHighlight = nil
        end
        print("❌ تم إيقاف ESP")
    end
end

-- إضافة زر ESP (Toggle)
local Toggle = Tab:AddToggle("HouseESP_Toggle", {
    Title = "تفعيل ESP للبيت",
    Description = "يظهر لون أخضر واضح حول بيتك",
    Default = false
})

Toggle:OnChanged(function(Value)
    toggleESP(Value)
end)

-- إضافة زر إغلاق نهائي للسكربت
Tab:AddButton({
    Title = "إغلاق السكربت نهائياً",
    Description = "يزيل الـ ESP ويخفي القائمة",
    Callback = function()
        -- إزالة الـ Highlight
        if currentHighlight then
            currentHighlight:Destroy()
        end
        
        -- إخفاء وإزالة النافذة
        Window:Destroy()
        
        print("🗑️ تم إغلاق السكربت نهائياً")
    end
})

print("🎮 تم تحميل السكربت - اسمك: " .. playerName)
