local Tab = Window:AddTab({ Title = "الرئيسية", Icon = "home" })

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerName = player.Name
local housingFolder = workspace:FindFirstChild("HousingTile")
local currentHighlight = nil
local espEnabled = false

if not housingFolder then
    warn("❌ لم يتم العثور على مجلد HousingTile!")
else
    print("✅ تم العثور على HousingTile")
    print("📁 عدد البيوت الموجودة: " .. #housingFolder:GetChildren())
    
    -- طباعة معلومات عن كل بيت
    for i, house in pairs(housingFolder:GetChildren()) do
