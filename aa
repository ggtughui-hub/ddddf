function GetMoney()
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    local hudLabel = PlayerGui and PlayerGui:FindFirstChild("TopRightHud") 
        and PlayerGui.TopRightHud:FindFirstChild("Holder") 
        and PlayerGui.TopRightHud.Holder:FindFirstChild("Frame") 
        and PlayerGui.TopRightHud.Holder.Frame:FindFirstChild("MoneyTextLabel")
    
    if hudLabel then
        local cleanText = hudLabel.Text:gsub(",", "")
        return tonumber(cleanText:match("%$(%d+)")) or 0
    end
    return 0
end

function ATMMoney()
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    for _, v in ipairs(PlayerGui:GetDescendants() or {}) do
        if v:IsA("TextLabel") and string.find(v.Text, "Bank Balance") then
            local cleanText = v.Text:gsub(",", "")
            return tonumber(cleanText:match("%$(%d+)")) or 0
        end
    end
    return 0
end

function GetSkill(skillName)
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return 0 end
    local Skills = PlayerGui:FindFirstChild("Skills")
    if not Skills then return 0 end
    local Holder = Skills:FindFirstChild("SkillsHolder")
    if not Holder then return 0 end
    local ScrollingFrame = Holder:FindFirstChild("SkillsScrollingFrame")
    if not ScrollingFrame then return 0 end
    
    for _, v in pairs(ScrollingFrame:GetChildren()) do
        if v.Name == "SkillOptionTemplate" then
            local title = v:FindFirstChild("SkillTitle")
            if title and string.find(title.Text, skillName) then
                return tonumber(title.Text:match("%d+")) or 0
            end
        end
    end
    return 0
end

function GetAtmIsNotHacked(atm)
    if not atm then return false end
    local keys = {}
    for k in pairs(atm:GetAttributes()) do
        table.insert(keys, k)
    end
    table.sort(keys)
    if keys[3] then
        return atm:GetAttribute(keys[3]) == false
    end
    return false
end

