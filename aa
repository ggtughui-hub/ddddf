-- ==============================================
-- سكربت ESP للبيت الخاص بك (HousingTile مجلد)
-- ==============================================

local player = game.Players.LocalPlayer
local username = player.Name  -- اسم حسابك في روبلوكس

-- متغيرات التحكم
local espEnabled = true
local espObjects = {}
local guiParent = nil
local housingFolder = nil

-- ==============================================
-- 1️⃣ إنشاء واجهة المستخدم (الأزرار)
-- ==============================================
local function createUI()
    -- إنشاء ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ESP_Menu"
    screenGui.Parent = player.PlayerGui
    
    guiParent = screenGui
    
    -- الإطار الرئيسي (خلفية الأزرار)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 50)
    frame.Position = UDim2.new(0.5, -100, 0.9, 0)  -- في أسفل المنتصف
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    
    -- زوايا مدورة
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    
    -- 🔘 زر ESP (تشغيل/إيقاف)
    local espButton = Instance.new("TextButton")
    espButton.Size = UDim2.new(0, 140, 0, 40)
    espButton.Position = UDim2.new(0, 10, 0, 5)
    espButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    espButton.Text = "🟢 ESP ON"
    espButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    espButton.TextSize = 18
    espButton.Font = Enum.Font.GothamBold
    espButton.Parent = frame
    
    -- زوايا مدورة للزر
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = espButton
    
    -- ❌ زر إغلاق (X)
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 40, 0, 40)
    closeButton.Position = UDim2.new(0, 155, 0, 5)
    closeButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    closeButton.Text = "✕"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextSize = 24
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = frame
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = closeButton
    
    -- ==============================================
    -- 2️⃣ وظائف الأزرار
    -- ==============================================
    
    -- زر ESP: تشغيل/إيقاف
    espButton.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        
        if espEnabled then
            espButton.Text = "🟢 ESP ON"
            espButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            updateESP()  -- إعادة تشغيل الـ ESP
        else
            espButton.Text = "🔴 ESP OFF"
            espButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            clearESP()   -- إزالة الـ ESP
        end
    end)
    
    -- زر الإغلاق (X): يوقف السكربت نهائياً
    closeButton.MouseButton1Click:Connect(function()
        clearESP()
        screenGui:Destroy()  -- حذف الواجهة
        espEnabled = false
        print("❌ تم إيقاف السكربت نهائياً")
    end)
    
    return screenGui
end

-- ==============================================
-- 3️⃣ وظائف ESP
-- ==============================================

-- إنشاء إطار ESP حول البيت
local function createESPBox(targetPart)
    if not targetPart or not targetPart.Parent then return end
    
    -- إطار ثلاثي الأبعاد (BoxHandleAdornment)
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "ESP_Box"
    box.Size = targetPart.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Adornee = targetPart
    box.Color3 = Color3.fromRGB(0, 255, 100)  -- أخضر زاهي
    box.Transparency = 0.3
    box.ZIndex = 10
    box.AlwaysOnTop = true
    box.Parent = targetPart
    
    -- Highlight عشان يبرز أكثر
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = targetPart
    highlight.FillColor = Color3.fromRGB(0, 255, 100)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.1
    highlight.Parent = targetPart
    
    -- حفظ في القائمة
    table.insert(espObjects, box)
    table.insert(espObjects, highlight)
    
    print("✅ تم تفعيل ESP على البيت: " .. targetPart.Name)
end

-- مسح كل الـ ESP
local function clearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    espObjects = {}
end

-- ==============================================
-- 4️⃣ الوظيفة الرئيسية: البحث عن البيت الخاص بك
-- ==============================================
local function updateESP()
    clearESP()  -- نمسح القديم
    
    if not espEnabled then return end
    
    -- نبحث عن مجلد HousingTile في الـ Workspace
    housingFolder = workspace:FindFirstChild("HousingTile")
    
    if not housingFolder then
        warn("⚠️ ما لقيت مجلد HousingTile في الـ Workspace!")
        return
    end
    
    if not housingFolder:IsA("Folder") and not housingFolder:IsA("Model") then
        warn("⚠️ HousingTile مو مجلد! نوعه: " .. housingFolder.ClassName)
        return
    end
    
    -- نجيب كل الأطفال داخل المجلد
    local houses = housingFolder:GetChildren()
    
    if #houses == 0 then
        warn("⚠️ مجلد HousingTile فاضي! ما فيه بيوت")
        return
    end
    
    print("🔍 جاري البحث عن بيتك بين " .. #houses .. " بيوت...")
    
    local found = false
    
    -- نفحص كل قطعة في المجلد
    for _, house in pairs(houses) do
        -- نتأكد إنها قطعة (BasePart)
        if house:IsA("BasePart") then
            local ownerName = house.Name  -- اسم القطعة = اسم صاحب البيت
            
            print("   - بيت: " .. ownerName)
            
            -- إذا كان اسم القطعة يساوي اسم حسابك
            if ownerName == username then
                print("✅✅✅ لقيت بيتك! 🎉")
                createESPBox(house)
                found = true
                break  -- نوقف البحث بما إننا لقينا البيت
            end
        end
    end
    
    if not found then
        print("❌ ما لقيت بيت باسم: " .. username)
        print("💡 تأكد من اسم حسابك: " .. username)
        print("💡 وتأكد إن البيت موجود في مجلد HousingTile")
    end
end

-- ==============================================
-- 5️⃣ مراقبة التغييرات
-- ==============================================

-- نشغل الواجهة
createUI()

-- ننتظر شوية عشان الـ Workspace يتحمل
task.wait(1.5)

-- أول تشغيل
print("🚀 بدء البحث عن البيت الخاص بك...")
print("👤 اسم حسابك: " .. username)
updateESP()

-- مراقبة إذا أضيف مجلد HousingTile جديد
workspace.ChildAdded:Connect(function(child)
    if child.Name == "HousingTile" and (child:IsA("Folder") or child:IsA("Model")) then
        print("📁 تم إضافة مجلد HousingTile جديد")
        task.wait(0.5)
        updateESP()
    end
end)

-- مراقبة إذا أضيف بيت جديد داخل المجلد
local function watchHousingFolder()
    if not housingFolder then return end
    
    housingFolder.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") then
            print("🏠 تم إضافة بيت جديد: " .. child.Name)
            task.wait(0.3)
            updateESP()
        end
    end)
end

-- إذا كان المجلد موجود من البداية، نراقبه
if housingFolder then
    watchHousingFolder()
end

-- مراقبة إذا تغير اسم أي قطعة في المجلد
game:GetService("RunService").Heartbeat:Connect(function()
    -- نحدث كل 3 ثواني فقط
    if espEnabled and tick() % 3 < 0.1 then
        -- نتحقق إذا تغير اسم أي بيت في المجلد
        if housingFolder and housingFolder.Parent then
            for _, house in pairs(housingFolder:GetChildren()) do
                if house:IsA("BasePart") and house.Name == username then
                    -- إذا لقينا بيت باسمنا وليس عليه ESP، نحدث
                    local hasESP = false
                    for _, obj in pairs(espObjects) do
                        if obj:IsA("BoxHandleAdornment") and obj.Adornee == house then
                            hasESP = true
                            break
                        end
                    end
                    if not hasESP then
                        updateESP()
                    end
                    break
                end
            end
        end
    end
end)

print("=========================================")
print("✅ السكربت جاهز! ينتظر ظهور البيت الخاص بك")
print("👤 إسمك: " .. username)
print("📁 المجلد المستهدف: HousingTile")
print("=========================================")
