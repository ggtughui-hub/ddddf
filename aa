if game.CoreGui:FindFirstChild("MyESP_GUI") then
    game.CoreGui.MyESP_GUI:Destroy()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local myUsername = LocalPlayer.Name

print("==============================")
print("اسم حسابك الحالي هو: " .. myUsername)
print("==============================")

local espEnabled = false
local activeHighlights = {}

-- الألوان الواضحة
local COLOR_HOUSE = Color3.fromRGB(0, 255, 0)     -- أخضر للبيت
local COLOR_FARM = Color3.fromRGB(255, 140, 0)     -- برتقالي للـ FarmingPot
local COLOR_OUTLINE = Color3.fromRGB(255, 255, 255) -- أبيض للأطراف

local function createHighlight(target, fillColor)
    if target and not target:FindFirstChild("CustomESP_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "CustomESP_HL"
        hl.Adornee = target
        hl.FillColor = fillColor
        hl.OutlineColor = COLOR_OUTLINE
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = target
        table.insert(activeHighlights, hl)
    end
end

local function clearESP()
    for _, hl in ipairs(activeHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    activeHighlights = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local h = obj:FindFirstChild("CustomESP_HL")
        if h then
            h:Destroy()
        end
    end
end

local function scanAndApplyESP()
    if not espEnabled then return end
    
    local myHouse = nil
    
    -- البحث داخل عناصر المنطقة عما يخص الـ House والـ OwnerLabel
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "House" or string.find(obj.Name:lower(), "house") then
            local exterior = obj:FindFirstChild("Exterior", true)
            if exterior then
                local ownerDisplay = exterior:FindFirstChild("OwnerDisplay")
                local bbGui = ownerDisplay and ownerDisplay:FindFirstChild("BillboardGui")
                local ownerLabel = bbGui and bbGui:FindFirstChild("OwnerLabel")
                
                if ownerLabel and ownerLabel:IsA("TextLabel") then
                    if ownerLabel.Text == myUsername or string.find(ownerLabel.Text, myUsername) then
                        myHouse = obj -- هذا هو بيتك المحدد
                        print("تم العثور على بيتك بنجاح!")
                        break
                    end
                end
            end
        end
    end
    
    if myHouse then
        -- عمل ESP للبيت الخاص بك فقط
        createHighlight(myHouse, COLOR_HOUSE)
        
        -- البحث عن أحواض الزراعة التابعة لبيتك فقط
        for _, pot in ipairs(myHouse:GetDescendants()) do
            if pot.Name == "FarmingPot" or string.find(pot.Name:lower(), "farmingpot") then
                createHighlight(pot, COLOR_FARM)
            end
        end
    else
        print("لم يتم العثور على بيت يطابق اسمك (" .. myUsername .. ").")
    end
end

