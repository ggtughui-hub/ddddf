    Icon = 'meat',
})

FarmTab:Section({
    Title = '🥩 Steak Farm:'
})

FarmTab:Toggle({
    Title = "Auto Farm Steak",
    Icon = "check",
    Type = "Checkbox",
    Value = false,
    Callback = function(Value)
        Config.SteakAutoFarm = Value
        if Value then
            SteakFarm.Active = true
            task.spawn(func['SteakFarm'])
        else
            SteakFarm.Active = false
            Sf:ForceStop()
        end
    end,
})

FarmTab:Section({
    Title = '📊 Status:'
})

local StatusLabel = FarmTab:Button({
    Title = "📋 Status",
    Desc = "Idle"
})

task.spawn(function()
    while task.wait(0.5) do
        if Config.SteakAutoFarm then
            local status = "🔄 Farming..."
            if SteakFarm.IsCooking then
                status = "🔥 Cooking..."
            elseif SteakFarm.HasMeat then
                status = "🍖 Has meat, going to grill..."
            else
                status = "🚶 Going to fridge..."
            end
            StatusLabel:SetDesc(status)
        else
            StatusLabel:SetDesc("⏸️ Stopped")
        end
    end
end)

