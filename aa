-- 1. إنشاء القائمة
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local Button = Instance.new("TextButton", ScreenGui) -- تم استخدام TextButton لتكون القائمة كاملة قابلة للضغط
Button.Size = UDim2.new(0, 180, 0, 70)
Button.Position = UDim2.new(0.1, 0, 0.4, 0)
Button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.TextSize = 16
Button.Active = true
Button.Draggable = true -- تقدر تحرك القائمة بيدك

-- 2. تحديث الإحداثيات تلقائياً داخل القائمة
game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        local pos = game.Players.LocalPlayer.Character.HumanoidRootPart.Position
        Button.Text = string.format("X: %.1f\nY: %.1f\nZ: %.1f", pos.X, pos.Y, pos.Z)
    end)
end)

-- 3. ضغطة واحدة على القائمة تنسخ الإحداثيات فوراً
Button.MouseButton1Click:Connect(function()
    pcall(function()
        local pos = game.Players.LocalPlayer.Character.HumanoidRootPart.Position
        local coords = string.format("%.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z)
        setclipboard(coords)
    end)
end\
