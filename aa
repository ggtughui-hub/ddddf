local function RemoveDoorsAndModifiers()
    for _, v in pairs(Workspace:GetDescendants()) do
        -- حذف نظام الأبواب
        if v.Name == "DoorSystem" or v.Name == "BasementDoor" then
            v:Destroy()
        end
        
        -- إضافة PathfindingModifier عشان السيارة تعدي
        if v:IsA("BasePart") and (v.Name == "DoorSystem" or v.Name == "BasementDoor") then
            v.CanCollide = false
            if not v:FindFirstChildOfClass("PathfindingModifier") then
                local modifier = Instance.new("PathfindingModifier")
                modifier.Label = "DoorArea"
                modifier.PassThrough = true
                modifier.Parent = v
            end
        end
    end
    
    -- حذف VehicleBlockers
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "VehicleBlockers" then
            v:Destroy()
        end
    end
end

-- تشغيل حذف الأبواب عند بداية السكربت
