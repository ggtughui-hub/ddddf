-- دالة البحث عن البيت - نسخة محسّنة
local function findMyHouse()
    if not housingFolder then return nil end
    
    for _, house in pairs(housingFolder:GetChildren()) do
        local ownerDisplay = house:FindFirstChild("OwnerDisplay")
        if ownerDisplay then
            local billboardGui = ownerDisplay:FindFirstChild("BillboardGui")
            if billboardGui then
                local ownerLabel = billboardGui:FindFirstChild("OwnerLabel")
                if ownerLabel then
                    -- محاولة مطابقة بعدة طرق
                    if ownerLabel.Text == playerName or 
                       ownerLabel.Text:find(playerName) or
                       tostring(ownerLabel.Text):lower() == playerName:lower() then
                        return house
                    end
                end
            end
        end
    end
    return nil
end

local function toggleESP(state)
    espEnabled = state
    
    if espEnabled then
        local myHouse = findMyHouse()
        if myHouse then
            if currentHighlight then
                currentHighlight:Destroy()
            end
            
            local highlight = Instance.new("Highlight")
            highlight.Name = "HouseESP"
            highlight.Adornee = myHouse
            highlight.FillColor = Color3.fromRGB(0, 255, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
            highlight.FillTransparency = 0.4
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = myHouse
            currentHighlight = highlight
            
            print("✅ تم تفعيل ESP على بيتك!")
        else
            warn("❌ لم يتم العثور على بيتك!")
            warn("💡 راجع الـ Output لمعرفة التفاصيل")
        end
    else
        if currentHighlight then
            currentHighlight:Destroy()
            currentHighlight = nil
        end
        print("❌ تم إيقاف ESP")
    end
end

local Toggle = Tab:AddToggle("HouseESP_Toggle", {
    Title = "تفعيل ESP للبيت",
    Description = "يظهر لون أخضر واضح حول بيتك",
    Default = false
})

Toggle:OnChanged(function(Value)
    toggleESP(Value)
end)

Tab:AddButton({
    Title = "إغلاق السكربت نهائياً",
    Description = "يزيل الـ ESP ويخفي القائمة",
    Callback = function()
        if currentHighlight then
            currentHighlight:Destroy()
        end
        Window:Destroy()
        print("🗑️ تم إغلاق السكربت")
