-- إنشاء نافذة الـ GUI
local CoreGui = game:GetService("CoreGui")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmMonitor"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 220, 0, 90)
Frame.Position = UDim2.new(0.8, 0, 0.1, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local Layout = Instance.new("UIListLayout")
Layout.Parent = Frame
Layout.Padding = UDim.new(0, 5)

-- النصوص
local HoldingLabel = Instance.new("TextLabel")
HoldingLabel.Size = UDim2.new(1, 0, 0.5, 0)
HoldingLabel.BackgroundTransparency = 1
HoldingLabel.TextColor3 = Color3.new(1, 1, 1)
HoldingLabel.Text = "Holding: Nothing"
HoldingLabel.Parent = Frame

local GrillLabel = Instance.new("TextLabel")
GrillLabel.Size = UDim2.new(1, 0, 0.5, 0)
GrillLabel.BackgroundTransparency = 1
GrillLabel.TextColor3 = Color3.new(1, 1, 1)
GrillLabel.Text = "Grill: Idle"
GrillLabel.Parent = Frame

-- المنطق البرمجي (فحص فقط)
task.spawn(function()
    while task.wait(0.5) do
        local char = game.Players.LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        -- تحديث نص الممسوك
        if tool then
            HoldingLabel.Text = "Holding: " .. tool.Name
        else
            HoldingLabel.Text = "Holding: Nothing"
        end

        -- الفحص عن الشواية إذا كنت تمسك "Steak"
        if tool and tool.Name == "Steak" then
            local foundGrill = false
            -- تأكد من اسم المجلد الصحيح في الـ Workspace
            local GrillsFolder = workspace:FindFirstChild("Grills") 
            
            if GrillsFolder then
                for _, obj in pairs(GrillsFolder:GetChildren()) do
                    -- التحقق من الشواية (تأكد من اسم خاصية المالك إذا كان مختلفاً عن Owner)
                    if obj:FindFirstChild("Owner") and obj.Owner.Value == game.Players.LocalPlayer.Name then
                        foundGrill = true
                        break
                    end
                end
            end

            if foundGrill then
                GrillLabel.Text = "✅ ظهرت الشواية"
                GrillLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            else
                GrillLabel.Text = "🔍 Searching..."
                GrillLabel.TextColor3 = Color3.new(1, 1, 1)
            end
        else
            GrillLabel.Text = "Grill: Idle"
            GrillLabel.TextColor3 = Color3.new(1, 1, 1)
        end
    end
end)
