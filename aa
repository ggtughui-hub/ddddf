local function GetBank()
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("TextLabel") and string.find(v.Text, "Bank Balance") then
            return tonumber(v.Text:match("%$(%d+)")) or 0
        end
    end
    return 0
end

local function GetHand()
    local raw = PlayerGui:FindFirstChild("TopRightHud") and PlayerGui.TopRightHud:FindFirstChild("Holder") and PlayerGui.TopRightHud.Holder:FindFirstChild("Frame") and PlayerGui.TopRightHud.Holder.Frame:FindFirstChild("MoneyTextLabel")
    if raw then
        local stripped = raw.Text:match("%$([%d,]+)")
        if stripped then return tonumber((stripped:gsub(",", ""))) or 0 end
    end
    return 0
end

