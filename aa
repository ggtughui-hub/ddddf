-- ========================================
local function StartSteakFarm()
    print("🥩 بدء فارم Steak...")
    
    -- التحقق من التوظيف
    if JobNow() ~= "steakhouse_cook" then
        print("🚶 جاري التوجه للتوظيف...")
        
        Sf:Teleport(STEAK_POS.Apply, Config.SteakAutoFarm, nil, 34)
        task.wait(0.5)
        
        local beacon = workspace:FindFirstChild("SteakHouseBeacon")
        if not beacon then
            pcall(function()
                beacon = workspace.Map.Tiles.ShoppingTile.SteakHouse.Interior:FindFirstChild("SteakHouseBeacon")
            end)
        end
        
        if beacon then
            print("📋 جاري إرسال طلب التوظيف...")
            Net.send("apply_for_job", beacon)
            task.wait(1.5)
            print("✅ تم إرسال طلب التوظيف")
        else
            print("❌ ما لقيت Beacon التوظيف")
        end
    else
        print("✅ أنت موظف في Steakhouse")
    end
    
    -- انتظار قبول التوظيف
    local waitCount = 0
    while JobNow() ~= "steakhouse_cook" and waitCount < 10 do
        task.wait(1)
        waitCount = waitCount + 1
        print("⏳ انتظار قبول التوظيف... " .. waitCount .. "/10")
    end
    
    if JobNow() ~= "steakhouse_cook" then
        print("❌ لم يتم قبول التوظيف!")
        return
    end
    
    print("✅ تم قبول التوظيف! بدء الفارم...")
    
    -- حلقة الفارم
    local cycleCount = 0
    
    while Config.SteakAutoFarm and SteakFarm.Active do
        cycleCount = cycleCount + 1
        print("🔄 دورة رقم " .. cycleCount)
        
        local success = CookMeat()
        
        if not success then
            print("⚠️ فشلت الدورة، إعادة المحاولة...")
            task.wait(2)
            SteakFarm.IsCooking = false
            SteakFarm.HasMeat = false
            SteakFarm.CurrentGrill = nil
        else
            print("✅ تم طهي اللحم بنجاح!")
            task.wait(1)
        end
    end
    
    print("🛑 توقف فارم Steak")
end

