    return grill:FindFirstChild("GrillArea")
end

-- ========================================
-- دالة CookMeat الكاملة
-- ========================================
local function CookMeat()
    local player = game.Players.LocalPlayer
    local char = player.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if not root then
        print("❌ ما لقيت HumanoidRootPart")
        return false
    end
    
    -- 1. التوجه للثلاجة
    print("🧊 التوجه للثلاجة...")
    Sf:Teleport(STEAK_POS.Fridge, Config.SteakAutoFarm, nil, 34)
    task.wait(0.5)
    
    -- 2. أخذ اللحم من الثلاجة
    local targetPrompt = FindStrictlySteakStation()
    
    if targetPrompt then
        print("✅ تم العثور على زر Steak!")
        fireproximityprompt(targetPrompt)
        
        -- ننتظر ثانيتين عشان اللحم يظهر في يدك
        print("⏳ ننتظر ثانيتين...")
        task.wait(2)
    else
        print("❌ ما لقيت زر Steak!")
        return false
    end

    -- 3. التأكد من وجود اللحم
    local meatTool = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("IsCookable") then
            meatTool = tool
            break
        end
    end
    
    if not meatTool then
        print("❌ ما لقيت اللحم في يدك")
        return false
    end
    
    print("✅ تم استلام اللحم! (" .. meatTool.Name .. ")")
    SteakFarm.HasMeat = true
    
    -- 4. طلب شواية من السيرفر (بعد الثانيتين)
    print("📡 جاري طلب شواية من السيرفر...")
    local grillId = Net.get("get_random_free_grill")
    
    if not grillId then
        print("❌ السيرفر ما رد بشواية!")
        return false
    end
    
    print("✅ استلمت ID الشواية: " .. tostring(grillId))
    
    -- 5. البحث عن الشواية
    local assignedGrill = nil
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "SteakGrill" and obj == grillId then
            assignedGrill = obj
            break
        end
    end
    
    if not assignedGrill then
        print("❌ ما لقيت الشواية!")
        return false
    end
    
    print("✅ تم العثور على الشواية!")
    SteakFarm.CurrentGrill = assignedGrill
    
    -- 6. التوجه للشواية
    local grillArea = GetGrillArea(assignedGrill)
    local targetPos
    
    if grillArea then
        targetPos = grillArea.Position + Vector3.new(0, 2, 0)
        print("📍 التوجه إلى GrillArea...")
    else
        targetPos = assignedGrill:GetPivot().Position + Vector3.new(0, 2, 0)
        print("📍 التوجه إلى الشواية...")
    end
    
    Sf:Teleport(targetPos, Config.SteakAutoFarm, nil, 34)
    task.wait(0.5)
    
    -- 7. بدء الطهي
    print("🔥 جاري إرسال أمر بدء الطهي...")
    Net.send("start_grilling_2", assignedGrill)
    print("✅ تم إرسال start_grilling_2")
    
    if grillArea then
        local charRoot = char:FindFirstChild("HumanoidRootPart")
        if charRoot then
            firetouchinterest(charRoot, grillArea, 0)
            task.wait(0.1)
            firetouchinterest(charRoot, grillArea, 1)
        end
    end
    
    SteakFarm.IsCooking = true
    
    -- 8. انتظار الطهي
    print("⏳ انتظار الطهي... (الحد الأقصى 35 ثانية)")
    local cookTimeout = tick() + 35
    local lastStatus = ""
    
    while tick() < cookTimeout do
        local status = assignedGrill:GetAttribute("cooked_status") or ""
        
        local stillHasMeat = false
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("IsCookable") then
                stillHasMeat = true
                break
            end
        end
        
        if not stillHasMeat and status == "" then
            print("✅ اللحم اختفى - اكتمل الطهي!")
            break
        end
        
        if status ~= lastStatus and status ~= "" then
            print("📊 حالة الطهي: " .. status)
            lastStatus = status
        end
        
        if status == "Cooked" or status == "Perfect" then
            print("✅ اكتمل الطهي بنجاح!")
            break
        elseif status == "Overcooked" then
            print("❌ احترق اللحم!")
            break
        end
        
        task.wait(0.5)
    end

    -- 9. تنظيف
    SteakFarm.IsCooking = false
    SteakFarm.HasMeat = false
    SteakFarm.CurrentGrill = nil
    
    print("✅ انتهت دورة الطهي!")
    return true
end

