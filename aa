local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- ========================
-- 🔒 نظام الحماية (Bypass Protection)
-- ========================

local function SetupBypassProtection()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local TransitionModule = require(RS.Modules.Game.UI.TransitionUI)
        if TransitionModule and TransitionModule.transition then
            TransitionModule.transition = function(p_in, p_wait, p_out, noLogo)
                return true
            end
        end
    end)

    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local CharCreator = require(RS.Modules.Game.CharacterCreator.CharacterCreator)
        if CharCreator then
            if CharCreator.start then
                CharCreator.start = function(...) return true end
            end
            if CharCreator.initiate then
                CharCreator.initiate = function(...) return true end
            end
        end
    end)

    pcall(function()
        local ATMFolder = workspace:FindFirstChild("Map")
        if ATMFolder then
            ATMFolder = ATMFolder:FindFirstChild("Props")
            if ATMFolder then
                ATMFolder = ATMFolder:FindFirstChild("ATMs")
                if ATMFolder then
                    for _, descendant in pairs(ATMFolder:GetDescendants()) do
                        if descendant:IsA("ProximityPrompt") then
                            descendant.MaxActivationDistance = 25
                            descendant.HoldDuration = 0.1
                        end
                    end
                end
            end
        end
    end)

    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "DoorSystem" or obj.Name == "BasementDoor") then
                obj:Destroy()
            end
        end
    end)

    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "DoorSystem" or v.Name == "BasementDoor" then
                for _, x in ipairs(v:GetDescendants()) do
                    if x:IsA('BasePart') then
                        x.CanCollide = false
                        if not x:FindFirstChildOfClass("PathfindingModifier") then
                            local modifier = Instance.new("PathfindingModifier")
                            modifier.Label = "DoorArea"
                            modifier.PassThrough = true
                            modifier.Parent = x
                        end
                    end
                end
            end
            if v.Name == "VehicleBlockers" then
                v:Destroy()
            end
        end
    end)

    pcall(function()
        if getgenv then
            getgenv().identifyexecutor = nil
        end
        if getfenv then
            local env = getfenv()
            env.identifyexecutor = nil
        end
    end)
end

-- ========================
-- 🛑 جميع المتغيرات في البداية = false
-- ========================

local FarmRunning = false
local CurrentGrill = nil
local CurrentFood = nil
local CookingTask = nil
local StatusLabel = nil
local ToggleButton = nil
local WalkTask = nil
local FoodModel = nil

-- ========================
-- 📦 الموديول
-- ========================

local FarmModule = {
    Config = {
        ToolName = "RawSteak",
        GrillTag = "SteakGrill",
        FridgeTag = "SteakFridge",
        DefaultCookTime = 10,
        DefaultPerfectTime = 6,
        DefaultPerfectLength = 1.5,
        WalkSpeed = 16,
        WalkTimeout = 30,
        ArrivalDistance = 3,
        UI = {
            FarmButtonText = "▶️ تشغيل الفارم",
            StopButtonText = "⏹️ إيقاف الفارم",
            StatusText = "⏸️ متوقف",
            StatusColor = Color3.fromRGB(255, 255, 255)
        }
    }
}

function FarmModule:GetGrills()
    local grills = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:GetAttribute("GrillType") == "SteakGrill" then
            table.insert(grills, obj)
        end
    end
    return grills
end

function FarmModule:FindAvailableGrill()
    local grills = self:GetGrills()
    for _, grill in pairs(grills) do
        if grill:GetAttribute("Occupied") == false then
            return grill
        end
    end
    return nil
end

-- ========================
-- دوال المساعدة
-- ========================

local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetHumanoid()
    local char = GetCharacter()
    return char:FindFirstChild("Humanoid")
end

local function GetHRP()
    local char = GetCharacter()
    return char:FindFirstChild("HumanoidRootPart")
end

local function GetTool(toolName)
    local char = GetCharacter()
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == toolName then
            return tool
        end
    end
    return nil
end

local function IsHoldingCookable()
    if not FarmRunning then return false end
    local tool = GetTool(FarmModule.Config.ToolName)
    if tool and tool:GetAttribute("IsCookable") then
        return true
    end
    return false
end

local function GetNearestGrill()
    if not FarmRunning then return nil end
    local hrp = GetHRP()
    if not hrp then return nil end
    
    local nearest = nil
    local shortestDist = math.huge
    
    local grills = FarmModule:GetGrills()
    for _, grill in pairs(grills) do
        if grill:GetAttribute("Occupied") == false then
            local grillPos = grill:GetPivot().Position
            local dist = (hrp.Position - grillPos).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearest = grill
            end
        end
    end
    
    return nearest, shortestDist
end

local function GetGrillArea(grill)
    return grill:FindFirstChild("GrillArea") or grill:FindFirstChildWhichIsA("BasePart")
end

local function GetWalkPosition(grill)
    local area = GetGrillArea(grill)
    if area then
        local pos = area.Position
        local size = area.Size
        return pos + Vector3.new(0, 0, size.Z/2 + 2)
    end
    return grill:GetPivot().Position + Vector3.new(0, 0, 3)
end

-- ========================
-- نظام المشي التلقائي
-- ========================

local function WalkToGrill(grill)
    if not FarmRunning then return false end
    
    local humanoid = GetHumanoid()
    local hrp = GetHRP()
    
    if not humanoid or not hrp then
        return false
    end
    
    local targetPos = GetWalkPosition(grill)
    local distance = (hrp.Position - targetPos).Magnitude
    
    if distance < FarmModule.Config.ArrivalDistance then
        return true
    end
    
    UpdateUI("🚶 المشي إلى الشواية...", Color3.fromRGB(255, 255, 0))
    
    if WalkTask then
        task.cancel(WalkTask)
        WalkTask = nil
    end
    
    humanoid.WalkSpeed = FarmModule.Config.WalkSpeed
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 45,
    })
    
    local success = pcall(function()
        path:ComputeAsync(hrp.Position, targetPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        WalkTask = task.spawn(function()
            for _, waypoint in pairs(waypoints) do
                if not FarmRunning then break end
                if not hrp or not humanoid then break end
                humanoid:MoveTo(waypoint.Position)
                humanoid.MoveToFinished:Wait(2)
            end
        end)
        
        local arrived = false
        local timeout = FarmModule.Config.WalkTimeout
        local startTime = tick()
        
        while not arrived and FarmRunning and (tick() - startTime) < timeout do
            task.wait(0.5)
            local currentDist = (hrp.Position - targetPos).Magnitude
            if currentDist < FarmModule.Config.ArrivalDistance then
                arrived = true
                break
            end
        end
        
        if WalkTask then
            task.cancel(WalkTask)
            WalkTask = nil
        end
        
        if arrived then
            humanoid:MoveTo(hrp.Position)
            return true
        end
        return false
    else
        WalkTask = task.spawn(function()
            humanoid:MoveTo(targetPos)
            humanoid.MoveToFinished:Wait(2)
        end)
        
        local arrived = false
        local timeout = FarmModule.Config.WalkTimeout
        local startTime = tick()
        
        while not arrived and FarmRunning and (tick() - startTime) < timeout do
            task.wait(0.5)
            local currentDist = (hrp.Position - targetPos).Magnitude
            if currentDist < FarmModule.Config.ArrivalDistance then
                arrived = true
                break
            end
        end
        
        if WalkTask then
            task.cancel(WalkTask)
            WalkTask = nil
        end
        
        if arrived then
            humanoid:MoveTo(hrp.Position)
            return true
        end
        return false
    end
end

-- ========================
-- نظام الطهي (بدون التحقق من الوظيفة ❌)
-- ========================

local function StartCooking(grill)
    if not FarmRunning then return false end
    if not grill then
        UpdateUI("❌ لا توجد شواية!", Color3.fromRGB(255, 0, 0))
        return false
    end
    
    if not IsHoldingCookable() then
        UpdateUI("❌ أمسك اللحم أولاً!", Color3.fromRGB(255, 165, 0))
        return false
    end
    
    -- ✅ تم إزالة التحقق من الوظيفة (Job) تماماً
    
    if not WalkToGrill(grill) then
        UpdateUI("❌ فشل الوصول!", Color3.fromRGB(255, 0, 0))
        return false
    end
    
    grill:SetAttribute("Occupied", true)
    CurrentGrill = grill
    
    local area = GetGrillArea(grill)
    if not area then
        grill:SetAttribute("Occupied", false)
        return false
    end
    
    local food = Instance.new("Model")
    food.Name = "CookingFood"
    
    local foodPart = Instance.new("Part")
    foodPart.Size = Vector3.new(0.5, 0.2, 0.5)
    foodPart.Shape = Enum.PartType.Ball
    foodPart.Color = Color3.fromRGB(150, 75, 50)
    foodPart.Material = Enum.Material.SmoothPlastic
    foodPart.Anchored = true
    foodPart.CanCollide = false
    foodPart.Parent = food
    
    local grillPos = area.Position + Vector3.new(0, area.Size.Y/2 + 0.3, 0)
    food:SetPrimaryPartCFrame(CFrame.new(grillPos))
    food.Parent = grill
    
    FoodModel = food
    CurrentFood = food
    
    local cookTime = grill:GetAttribute("CookTime") or FarmModule.Config.DefaultCookTime
    local perfectTime = grill:GetAttribute("PerfectTime") or FarmModule.Config.DefaultPerfectTime
    local perfectLength = grill:GetAttribute("PerfectLength") or FarmModule.Config.DefaultPerfectLength
    
    UpdateUI("🔥 جاري الطهي...", Color3.fromRGB(255, 165, 0))
    
    local startTime = tick()
    local perfectStart = perfectTime - perfectLength
    local perfectEnd = perfectTime + perfectLength
    
    CookingTask = task.spawn(function()
        local elapsed = 0
        while elapsed < cookTime and FarmRunning do
            elapsed = tick() - startTime
            
            if FoodModel then
                local part = FoodModel:FindFirstChildWhichIsA("BasePart")
                if part then
                    if elapsed >= perfectStart and elapsed <= perfectEnd then
                        part.Color = Color3.fromRGB(255, 215, 0)
                    elseif elapsed < perfectStart then
                        part.Color = Color3.fromRGB(200, 100, 50)
                    else
                        part.Color = Color3.fromRGB(100, 50, 20)
                    end
                end
            end
            
            local progressPercent = math.floor((elapsed / cookTime) * 100)
            UpdateUI("🔥 الطهي: " .. progressPercent .. "%", Color3.fromRGB(255, 165, 0))
            
            RunService.Heartbeat:Wait()
        end
        
        if FarmRunning then
            FinishCooking(elapsed, cookTime, perfectStart, perfectEnd)
        else
            CancelCooking()
        end
    end)
    
    return true
end

local function FinishCooking(elapsed, totalTime, perfectStart, perfectEnd)
    local statusText = ""
    local color = Color3.fromRGB(255, 255, 255)
    
    if elapsed >= perfectStart and elapsed <= perfectEnd then
        statusText = "✨ مثالي!"
        color = Color3.fromRGB(255, 215, 0)
    elseif elapsed < perfectStart then
        statusText = "❌ غير ناضج!"
        color = Color3.fromRGB(255, 100, 100)
    else
        statusText = "🔥 محروق!"
        color = Color3.fromRGB(255, 0, 0)
    end
    
    UpdateUI("✅ تم الطهي: " .. statusText, color)
    task.wait(2)
    CleanupGrill()
end

local function CancelCooking()
    UpdateUI("⏹️ تم الإلغاء", Color3.fromRGB(255, 0, 0))
    CleanupGrill()
end

local function CleanupGrill()
    if FoodModel then
        FoodModel:Destroy()
        FoodModel = nil
    end
    
    if CurrentGrill then
        CurrentGrill:SetAttribute("Occupied", false)
        CurrentGrill = nil
    end
    
    CurrentFood = nil
    
    if CookingTask then
        task.cancel(CookingTask)
        CookingTask = nil
    end
    
    if WalkTask then
        task.cancel(WalkTask)
        WalkTask = nil
    end
    
    if not FarmRunning then
        UpdateUI("⏸️ متوقف", Color3.fromRGB(255, 255, 255))
    end
end

-- ========================
-- حلقة الفارم الرئيسية
-- ========================

local function FarmLoop()
    while FarmRunning do
        -- 1. التأكد من وجود اللحم
        if not IsHoldingCookable() then
            local tool = GetTool(FarmModule.Config.ToolName)
            if not tool then
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if backpack then
                    for _, item in pairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and item.Name == FarmModule.Config.ToolName then
                            item.Parent = GetCharacter()
                            UpdateUI("🥩 تم إمساك اللحم!", Color3.fromRGB(0, 255, 0))
                            break
                        end
                    end
                end
            end
            task.wait(0.5)
            continue
        end
        
        -- 2. البحث عن شواية فارغة
        if not CurrentGrill then
            local grill = FarmModule:FindAvailableGrill()
            if grill then
                if StartCooking(grill) then
                    UpdateUI("✅ بدأ الطهي!", Color3.fromRGB(0, 255, 0))
                else
                    task.wait(2)
                end
            else
                UpdateUI("⏳ انتظار شواية...", Color3.fromRGB(255, 255, 0))
                task.wait(2)
            end
        end
        
        -- 3. انتظار انتهاء الطهي
        while CurrentGrill and FarmRunning do
            task.wait(1)
        end
        
        task.wait(0.5)
    end
end

