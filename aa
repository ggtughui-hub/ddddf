function GetItemInfo(itemName)
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return {0, false, nil, false, false} end
    
    local Items = PlayerGui:FindFirstChild("Items")
    if not Items then return {0, false, nil, false, false} end
    
    local Holder = Items:FindFirstChild("ItemsHolder")
    if not Holder then return {0, false, nil, false, false} end
    
    local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return {0, false, nil, false, false} end
    
    for _, v in pairs(ScrollingFrame:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemNameLabel = v:FindFirstChild("ItemName")
            if itemNameLabel and itemNameLabel.Text == itemName then
                local equipped = v:FindFirstChild("ItemEquipped")
                local destroyed = v:FindFirstChild("DestroyedItemIcon")
                return {
                    1,
                    true,
                    v.Name,
                    equipped and equipped.Visible or false,
                    destroyed and destroyed.Visible or false
                }
            end
        end
    end
    return {0, false, nil, false, false}
end

function DriveToATM()
    local shortestDist = math.huge
    local atmPos = nil
    local ATMFolder = Workspace:FindFirstChild("Map") 
        and Workspace.Map:FindFirstChild("Props") 
        and Workspace.Map.Props:FindFirstChild("ATMs")
    
    if ATMFolder then
        for _, atm in ipairs(ATMFolder:GetChildren()) do
            if atm.Name == "ATM" and GetAtmIsNotHacked(atm) then
                local pos = atm.PrimaryPart and atm.PrimaryPart.Position
                if not pos then
                    for _, part in ipairs(atm:GetDescendants()) do
                        if part:IsA("BasePart") then
                            pos = part.Position
                            break
                        end
                    end
                end
                if pos then
                    local d = distTo(pos)
                    if d < shortestDist then
                        shortestDist = d
                        atmPos = pos
                    end
                end
            end
        end
    end
    
    if atmPos then
        if Config.UseVehicle then
            local vehicle = GetSpawnedVehicle()
            if vehicle then
                DriveToLocation(vehicle, atmPos)
                return true
            end
        end
        Teleport(atmPos)
        return true
    end
    return false
end

