local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RentHomeGui"
screenGui.Parent = playerGui

local textButton = Instance.new("TextButton")
textButton.Name = "RentButton"
textButton.Size = UDim2.new(0, 200, 0, 50)
textButton.Position = UDim2.new(0.5, -100, 0.5, -25)
textButton.Text = "Rent Home"
textButton.TextSize = 20
textButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
textButton.TextColor3 = Color3.fromRGB(255, 255, 255)
textButton.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = textButton

textButton.MouseButton1Click:Connect(function()
    local success, targetPart = pcall(function()
        return workspace.Map.Tiles:GetChildren()[14]:GetChildren()[4].TrapHouseA
    end)
    
    if success and targetPart then
        local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Send")
        
        if remote and remote:IsA("RemoteFunction") then
            remote:InvokeServer("rent_home", targetPart)
        end
    end
end)
