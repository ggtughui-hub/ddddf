-- ESP Script مع زر تشغيل/إيقاف
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerName = player.Name

-- البحث عن مجلد HousingTile
local housingFolder = workspace:FindFirstChild("HousingTile")

if not housingFolder then
    warn("لم يتم العثور على مجلد HousingTile!")
    return
end

-- إنشاء زر الـ ESP
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HouseESP_Gui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = player:WaitForChild("PlayerGui")

local ESPButton = Instance.new("TextButton")
ESPButton.Name = "ESPButton"
ESPButton.Size = UDim2.new(0, 150, 0, 50)
ESPButton.Position = UDim2.new(0, 10, 0, 10)
ESPButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ESPButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ESPButton.TextSize = 18
ESPButton.Font = Enum.Font.GothamBold
ESPButton.Text = "ESP: OFF"
ESPButton.BorderSizePixel = 0
ESPButton.Parent = ScreenGui

-- إضافة حدود للزر
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = ESPButton

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Thickness = 2
stroke.Parent = ESPButton

-- متغير حالة الـ ESP
local espEnabled = false
local currentHighlight = nil

-- دالة إنشاء/إزالة ESP
local function toggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        ESPButton.Text = "ESP: ON"
        ESPButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        -- البحث عن البيت الخاص بك
        for _, house in pairs(housingFolder:GetChildren()) do
            local ownerDisplay = house:FindFirstChild("OwnerDisplay")
            if ownerDisplay then
                local billboardGui = ownerDisplay:FindFirstChild("BillboardGui")
                if billboardGui then
                    local ownerLabel = billboardGui:FindFirstChild("OwnerLabel")
                    if ownerLabel and ownerLabel.Text == playerName then
                        -- إزالة Highlight قديم
                        if currentHighlight then
                            currentHighlight:Destroy()
                        end
                        
                        -- إنشاء Highlight جديد
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "HouseESP"
                        highlight.Adornee = house
                        highlight.FillColor = Color3.fromRGB(0, 255, 0)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                        highlight.FillTransparency = 0.4
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = house
                        currentHighlight = highlight
                        
                        print("تم تفعيل ESP على بيتك!")
                        break
                    end
                end
            end
        end
    else
        ESPButton.Text = "ESP: OFF"
        ESPButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        -- إزالة الـ ESP
        if currentHighlight then
            currentHighlight:Destroy()
            currentHighlight = nil
        end
        print("تم إيقاف ESP")
    end
end

-- ربط الزر بالدالة
ESPButton.MouseButton1Click:Connect(toggleESP)

print("تم تحميل سكربت ESP - اسم حسابك: " .. playerName)
print("اضغط على الزر في أعلى يسار الشاشة لتشغيل الـ ESP")
