if game.CoreGui:FindFirstChild("MyESP_GUI") then
    game.CoreGui.MyESP_GUI:Destroy()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local myUsername = LocalPlayer.Name

print("==============================")
print("اسم حسابك الحالي هو: " .. myUsername)
print("==============================")

local espEnabled = false
local activeHighlights = {}

-- الألوان الواضحة
local COLOR_HOUSE = Color3.fromRGB(0, 255, 0)     -- أخضر للبيت
local COLOR_FARM = Color3.fromRGB(255, 140, 0)     -- برتقالي للـ FarmingPot
local COLOR_OUTLINE = Color3.fromRGB(255, 255, 255) -- أبيض للأطراف

local function createHighlight(target, fillColor)
    if target and not target:FindFirstChild("CustomESP_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "CustomESP_HL"
        hl.Adornee = target
        hl.FillColor = fillColor
        hl.OutlineColor = COLOR_OUTLINE
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = target
        table.insert(activeHighlights, hl)
    end
end

local function clearESP()
    for _, hl in ipairs(activeHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    activeHighlights = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local h = obj:FindFirstChild("CustomESP_HL")
        if h then
            h:Destroy()
        end
    end
end

local function scanAndApplyESP()
    if not espEnabled then return end
    
    local myTargetHouse = nil
    
    -- 1. البحث حصرياً داخل كل HousingTile في الخريطة
    for _, tile in ipairs(Workspace:GetDescendants()) do
        if tile.Name == "HousingTile" then
            -- 2. البحث عن House بداخله
            local houseModel = tile:FindFirstChild("House")
            if houseModel then
                -- 3. اتباع المسار الدقيق الموضح في الصورة للوصول إلى OwnerLabel
                for _, descendant in ipairs(houseModel:GetDescendants()) do
                    if descendant.Name == "OwnerLabel" and descendant:IsA("TextLabel") then
                        -- التحقق من مطابقة اسمك مع النص داخل الـ OwnerLabel
                        if descendant.Text == myUsername or string.find(descendant.Text, myUsername) then
                            myTargetHouse = houseModel -- تحديد نموذج الـ House الخاص بك بالكامل
                            print("تم العثور على بيتك بنجاح داخل الـ HousingTile!")
                            break
                        end
                    end
                end
            end
            if myTargetHouse then break end
        end
    end
    
    if myTargetHouse then
        -- عمل ESP للبيت الخاص بك فقط (مجلد House)
        createHighlight(myTargetHouse, COLOR_HOUSE)
        
        -- البحث عن أحواض الزراعة التابعة لبيتك فقط وتلوينها بالبرتقالي
        for _, obj in ipairs(myTargetHouse:GetDescendants()) do
            if obj.Name == "FarmingPot" or string.find(obj.Name:lower(), "farmingpot") then
                createHighlight(obj, COLOR_FARM)
            end
        end
    else
        print("لم يتم العثور على بيت يطابق اسمك (" .. myUsername .. ") داخل أي HousingTile.")
    end
end

