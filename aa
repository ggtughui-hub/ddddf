local BIKE_ATM_CFRAME = CFrame.new(179.200882, 255.290543, -236.355896)
function Sf:BuyBikeCrate()
    local bikeCrate = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Tiles") and workspace.Map.Tiles:FindFirstChild("BurgerPlaceTile") and workspace.Map.Tiles.BurgerPlaceTile:FindFirstChild("UrbanCyclesAndSkates") and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates:FindFirstChild("Interior") and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates.Interior:FindFirstChild("Crates") and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates.Interior.Crates:FindFirstChild("Bike Crate")
    if not bikeCrate then return end
    local touchPart = bikeCrate:FindFirstChild("Beacon") and bikeCrate.Beacon:FindFirstChild("TouchPart")
    if not touchPart then return end

    if Sf:GetMoney() < BIKE_CRATE_COST then
        local atm = Sf:FindClosestAvailableATM()
        if atm then
            Sf:Teleport(atm.Area.Position, true)
            task.wait(0.1)
            local needed = BIKE_CRATE_COST - Sf:GetMoney()
            if needed > 0 then Net.get("transfer_funds", "bank", "hand", needed); task.wait(0.1) end
        else return end
    end
    Sf:Teleport(touchPart.Position, true)
    task.wait(0.1)
    Net.get("open_crate", bikeCrate:FindFirstChild("CrateOptions") and bikeCrate.CrateOptions:FindFirstChild("Basic"), "money")
    task.wait(0.3)
end

function Sf:FindClosestAvailableATM()
    local atmFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
    if not atmFolder then return nil end
    local closest, shortest = nil, math.huge
    for _, atm in pairs(atmFolder:GetChildren()) do
        if atm.Name == "ATM" and GetAtmIsNotHackedJob(atm) then
            local d = distTo(atm:FindFirstChild("Area") and atm.Area.Position or atm:GetPivot().Position)
            if d < shortest then shortest = d; closest = atm end
        end
    end
    return closest
end

