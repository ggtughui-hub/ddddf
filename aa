func['StartFarmJob'] = function()
	while task.wait(0.2) do
		if not Config.StartFarmJob or not StateController.JobSystemActive then
			Sf:ForceStop()
			break
		end
		
		CheckAndDeposit()
		local Jobs = Config.SelectedJob
		if Jobs == "None" then task.wait(1) continue end
		
		-- 🥩 STEAK HOUSE JOB (معدل ومصلح بالكامل)
		if Jobs == "Steak" then
			local beacon = workspace.Map.Tiles.ShoppingTile.SteakHouse.Interior:FindFirstChild("SteakHouseBeacon") or workspace:FindFirstChild("SteakHouseBeacon")
			
			if JobNow() ~= "steakhouse_cook" then
				print("💼 جاري التقديم على وظيفة الطباخ...")
				if beacon then
					Sf:Teleport(beacon.Position, Config.StartFarmJob)
					task.wait(0.2)
					Net.get("apply_for_job", beacon)
					task.wait(0.5)
				else
					Sf:Teleport(Vector3.new(-262.798, 252.909, 343.73), Config.StartFarmJob)
				end
			else
				local handMoney = Sf:GetMoney()
				if Config.AutoDepositJob and handMoney >= Config.DepositThreshold then
					task.wait(1)
				else
					-- 1. الذهاب للثلاجة للحصول على اللحم
					local fridgePos = Vector3.new(-279.046, 252.909, 335.229)
					if distTo(fridgePos) > 4 then
						Sf:Teleport(fridgePos, Config.StartFarmJob)
						task.wait(0.2)
					end
					
					local fridge = workspace:FindFirstChild("SteakFridge", true) or workspace.Map.Tiles.ShoppingTile.SteakHouse.Interior:FindFirstChild("SteakFridge", true)
					if fridge then
						local prompt = fridge:FindFirstChildWhichIsA("ProximityPrompt", true)
						if prompt then
							fireproximityprompt(prompt)
							task.wait(0.3)
						end
					end
					
					-- 2. التوجه للشواية الفارغة وطهي اللحم تلقائياً
					local bestGrill = nil
					for _, obj in pairs(workspace:GetDescendants()) do
						if obj:IsA("Model") and obj.Name == "SteakGrill" then
							local uId = obj:GetAttribute("user_id_assigned") or 0
							if uId == 0 or uId == UserId then
								bestGrill = obj
								break
							end
						end
					end
					
					if bestGrill then
						local mainPart = bestGrill.PrimaryPart or bestGrill:FindFirstChild("GrillArea") or bestGrill:FindFirstChildWhichIsA("BasePart")
						if mainPart then
							Sf:Teleport(mainPart.Position + Vector3.new(0, 2, 0), Config.StartFarmJob)
							task.wait(1.5) -- انتظر الطهي حتى ينتهي
						end
					else
						task.wait(1)
					end
				end
			end

		-- JANITOR JOB
		elseif Jobs == "Janitor" then
			local bPlace = workspace:FindFirstChild("BurgePlaceBeacon")
			if JobNow() ~= "janitor" then
				if bPlace then
					Sf:Teleport(bPlace.Position, Config.StartFarmJob)
					Net.get("apply_for_job", bPlace)
				else
					Sf:Teleport(Vector3.new(110.824829, 255.190384, -309.609131), Config.StartFarmJob)
				end
			else
				if Character:FindFirstChild(FindBestTool('Janitor')) then
					local PuddlesFolder = workspace.Map.Tiles.BurgerPlaceTile.BurgerPlace.Interior.Puddles
					local PuddleNear = GetNearThing(PuddlesFolder, "Puddle", function(puddle)
						return puddle:IsA("BasePart") and puddle.Transparency < 1
					end)
					if not CheckingIsProgess() and PuddleNear then
						Sf:Teleport(PuddleNear.Position, Config.StartFarmJob)
					end
				else
					local tool = FindItem(FindBestTool('Janitor'))[2]
					if tool then Humanoid:EquipTool(tool) end
				end
			end
			
		-- QUICK-11 JOB
		elseif Jobs == "Quick-11" then
			local qBeacon = workspace.Map.Tiles.GasStationTile.Quick11.Interior:FindFirstChild("Quick11Beacon")
			if JobNow() ~= "shelf_stocker" then
				if qBeacon then
					Sf:Teleport(qBeacon.Position, Config.StartFarmJob)
					Net.get("apply_for_job", qBeacon)
				else
					Sf:Teleport(Vector3.new(133.074203, 255.315063, 208.3764049), Config.StartFarmJob)
				end
			else
				local boxJob = workspace.Map.Tiles.GasStationTile.Quick11.Interior.ShelfStockingJob
				local boxTool = Backpack:FindFirstChild("BoxTool") or Character:FindFirstChild("BoxTool")
				if not boxTool then
					local pos = Config.GoldBox and Vector3.new(129.082565, 237.444138, 210.597443) or Vector3.new(133.074203, 255.315063, 208.376404)
					Sf:Teleport(pos, Config.StartFarmJob)
					local prompt = Config.GoldBox and boxJob.GoldenBox:FindFirstChild('ProximityPrompt') or boxJob.NormalBox:FindFirstChild('ProximityPrompt')
					if prompt then fireproximityprompt(prompt) end
				else
					if not Character:FindFirstChild("BoxTool") then Humanoid:EquipTool(boxTool) end
					Getunpack(boxJob.Shelves, function(v)
						if v:FindFirstChild("Attachment") then Sf:Teleport(v.Position, Config.StartFarmJob) end
					end)
				end
			end
		end
	end
end

