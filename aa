local FarmModule = {
    Config = {
        JobRequired = "steakhouse_cook",
        ToolName = "RawSteak",
        GrillTag = "SteakGrill",
        FridgeTag = "SteakFridge",
        DefaultCookTime = 10,
        DefaultPerfectTime = 6,
        DefaultPerfectLength = 1.5,
        WalkSpeed = 16,
        WalkTimeout = 30,
        ArrivalDistance = 3,
        UI = {
            FarmButtonText = "تشغيل الفارم 🔥",
            StopButtonText = "إيقاف الفارم ⏹️",
            StatusText = "الحالة: متوقف",
            StatusColor = Color3.fromRGB(255, 0, 0)
        }
    }
}

function FarmModule:GetGrills()
    local grills = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:GetAttribute("GrillType") == "SteakGrill" then
            table.insert(grills, obj)
        end
    end
    return grills
end

function FarmModule:GetFridges()
    local fridges = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:GetAttribute("FridgeType") == "SteakFridge" then
            table.insert(fridges, obj)
        end
    end
    return fridges
end

function FarmModule:FindAvailableGrill()
    local grills = self:GetGrills()
    for _, grill in pairs(grills) do
        if grill:GetAttribute("Occupied") == false then
            return grill
        end
    end
    return nil
end

