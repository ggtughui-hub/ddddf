-- ==============================================
-- سكربت ESP للبيت الخاص بك (يدور داخل House)
-- ==============================================

local player = game.Players.LocalPlayer
local username = player.Name

-- متغيرات التحكم
local espEnabled = true
local espObjects = {}
local housingFolder = nil

-- ==============================================
-- 1️⃣ إنشاء واجهة المستخدم (الأزرار)
-- ==============================================
local function createUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ESP_Menu"
    screenGui.Parent = player.PlayerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 50)
    frame.Position = UDim2.new(0.5, -100, 0.9, 0)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    
    -- زر ESP
    local espButton = Instance.new("TextButton")
    espButton.Size = UDim2.new(0, 140, 0, 40)
    espButton.Position = UDim2.new(0, 10, 0, 5)
    espButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    espButton.Text = "🟢 ESP ON"
    espButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    espButton.TextSize = 18
    espButton.Font = Enum.Font.GothamBold
    espButton.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = espButton
    
    -- زر إغلاق X
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 40, 0, 40)
    closeButton.Position = UDim2.new(0, 155, 0, 5)
    closeButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    closeButton.Text = "✕"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextSize = 24
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = frame
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = closeButton
    
    -- وظائف الأزرار
    espButton.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        
        if espEnabled then
            espButton.Text = "🟢 ESP ON"
            espButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            updateESP()
        else
            espButton.Text = "🔴 ESP OFF"
            espButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            clearESP()
        end
    end)
    
    closeButton.MouseButton1Click:Connect(function()
        clearESP()
        screenGui:Destroy()
        espEnabled = false
        print("❌ تم إيقاف السكربت نهائياً")
    end)
    
    return screenGui
end

-- ==============================================
-- 2️⃣ وظائف ESP
-- ==============================================

local function createESPBox(targetPart)
    if not targetPart or not targetPart.Parent then return end
    
    -- BoxHandleAdornment (إطار ثلاثي الأبعاد)
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "ESP_Box"
    box.Size = targetPart.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Adornee = targetPart
    box.Color3 = Color3.fromRGB(0, 255, 100)
    box.Transparency = 0.3
    box.ZIndex = 10
    box.AlwaysOnTop = true
    box.Parent = targetPart
    
    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = targetPart
    highlight.FillColor = Color3.fromRGB(0, 255, 100)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.1
    highlight.Parent = targetPart
    
    table.insert(espObjects, box)
    table.insert(espObjects, highlight)
    
    print("✅ ESP مفعل على البيت: " .. targetPart.Name)
end

local function clearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    espObjects = {}
end

-- ==============================================
-- 3️⃣ الوظيفة الرئيسية: البحث عن البيت الخاص بك
-- ==============================================

local function updateESP()
    clearESP()
    
    if not espEnabled then return end
    
    -- البحث عن مجلد HousingTile
    housingFolder = workspace:FindFirstChild("HousingTile")
    
    if not housingFolder then
        warn("⚠️ ما لقيت مجلد HousingTile!")
        return
    end
    
    -- نجيب كل البيوت (اللي اسمها House)
    local houses = {}
    for _, child in pairs(housingFolder:GetChildren()) do
        if child.Name == "House" then
            table.insert(houses, child)
        end
    end
    
    if #houses == 0 then
        warn("⚠️ ما فيه بيوت في HousingTile!")
        return
    end
    
    print("🔍 جاري البحث عن بيتك بين " .. #houses .. " بيوت...")
    
    local found = false
    
    -- نفحص كل بيت
    for _, house in pairs(houses) do
        -- نبحث عن OwnerDisplay -> BillboardGui -> OwnerLabel
        local ownerDisplay = house:FindFirstChild("OwnerDisplay")
        
        if ownerDisplay then
            local billboard = ownerDisplay:FindFirstChild("BillboardGui")
            
            if billboard then
                local ownerLabel = billboard:FindFirstChild("OwnerLabel")
                
                if ownerLabel and ownerLabel:IsA("TextLabel") then
                    local ownerName = ownerLabel.Text
                    
                    print("   - بيت: " .. ownerName)
                    
                    -- نقارن الاسم
                    if ownerName == username then
                        print("✅✅✅ لقينا بيتك! 🎉")
                        
                        -- نبحث عن الـ Exterior عشان نسوي ESP عليه
                        local exterior = house:FindFirstChild("Exterior")
                        
                        if exterior and exterior:IsA("BasePart") then
                            createESPBox(exterior)
                            found = true
                            break
                        else
                            -- إذا ما لقينا Exterior، نسوي ESP على الـ House نفسه
                            local housePart = house:FindFirstChildWhichIsA("BasePart")
                            if housePart then
                                createESPBox(housePart)
                                found = true
                                break
                            else
                                warn("⚠️ ما لقينا قطعة في البيت عشان نسوي ESP")
                            end
                        end
                    end
                end
            end
        end
    end
    
    if not found then
        print("❌ ما لقيت بيت باسم: " .. username)
        print("💡 تأكد من اسمك: " .. username)
    end
end

-- ==============================================
-- 4️⃣ تشغيل السكربت
-- ==============================================

createUI()
task.wait(1.5)

print("🚀 بدء البحث عن البيت...")
print("👤 اسمك: " .. username)
updateESP()

-- مراقبة إضافة بيوت جديدة
local function watchHouses()
    if not housingFolder then return end
    
    housingFolder.ChildAdded:Connect(function(child)
        if child.Name == "House" then
            print("🏠 تم إضافة بيت جديد")
            task.wait(0.5)
            updateESP()
        end
    end)
end

if housingFolder then
    watchHouses()
end

-- تحديث دوري
game:GetService("RunService").Heartbeat:Connect(function()
    if espEnabled and tick() % 3 < 0.1 then
        -- نتحقق إذا البيت موجود وليس عليه ESP
        if housingFolder and housingFolder.Parent then
            for _, house in pairs(housingFolder:GetChildren()) do
                if house.Name == "House" then
                    local ownerDisplay = house:FindFirstChild("OwnerDisplay")
                    if ownerDisplay then
                        local billboard = ownerDisplay:FindFirstChild("BillboardGui")
                        if billboard then
                            local ownerLabel = billboard:FindFirstChild("OwnerLabel")
                            if ownerLabel and ownerLabel:IsA("TextLabel") and ownerLabel.Text == username then
                                -- نتأكد إن ESP شغال
                                local hasESP = false
                                for _, obj in pairs(espObjects) do
                                    if obj:IsA("BoxHandleAdornment") then
                                        hasESP = true
                                        break
                                    end
                                end
                                if not hasESP then
                                    updateESP()
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

print("=========================================")
print("✅ السكربت جاهز!")
print("👤 إسمك: " .. username)
print("📁 المسار: HousingTile > House > OwnerDisplay > BillboardGui > OwnerLabel")
print("=========================================")
