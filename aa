-- =================================================================
-- STEAK FARM - الكود الكامل المدمج (حماية + مسارات + توظيف + طهي)
-- =================================================================

local RS = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local Net = require(RS.Modules.Core.Net)
local CharModule = require(RS.Modules.Core.Char)

-- 1. نظام الحماية (Bypass)
local SendRemote = RS:WaitForChild("Remotes"):WaitForChild("Send")
local oldFireServer
oldFireServer = hookfunction(SendRemote.FireServer, function(self, ...)
    local args = {...}
    if args[2] == "crashed_car" then return nil end
    return oldFireServer(self, ...)
end)

-- 2. إعدادات النظام
local Config = { SteakAutoFarm = false, Running = false, StopWalking = false }
local STEAK_POS = { Apply = Vector3.new(-262.798, 252.909, 343.73), Fridge = Vector3.new(-279.046, 252.909, 335.229) }

-- 3. دالة المسارات (Pathfinding)
local function Sf_Teleport(destination)
    Config.StopWalking = false
    local RootPart = game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local path = PathfindingService:CreatePath({AgentCanJump = true})
    path:ComputeAsync(RootPart.Position, destination)
    
    if path.Status == Enum.PathStatus.Success then
        for _, wp in pairs(path:GetWaypoints()) do
            if Config.StopWalking then break end
            RootPart:PivotTo(CFrame.new(wp.Position + Vector3.new(0, 3, 0)))
            task.wait(0.1)
        end
    end
end

-- 4. منطق التوظيف والطهي (Main Logic)
local function PerformSteakFarm()
    local player = game.Players.LocalPlayer
    
    -- أ. التحقق من التوظيف
    if player:GetAttribute('Job') ~= "steakhouse_cook" then
        Sf_Teleport(STEAK_POS.Apply)
        local beacon = workspace:FindFirstChild("SteakHouseBeacon", true)
        if beacon then Net.send("apply_for_job", beacon) task.wait(1) end
    end

    -- ب. الحصول على اللحم
    Sf_Teleport(STEAK_POS.Fridge)
    local target = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (v.Parent.Name == "Get Steak" or string.find(string.lower(v.ObjectText), "steak")) then
            target = v break
        end
    end
    if target then fireproximityprompt(target) task.wait(0.5) end

    -- ج. الطهي والتحقق من الحالة
    if player.Character:FindFirstChild("Steak") then
        local grill = nil
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "SteakGrill" and obj:GetAttribute("user_id_assigned") == player.UserId then
                grill = obj break
            end
        end

        if grill then
            Sf_Teleport(grill:GetPivot().Position)
            Net.send("start_grilling_2", grill)
            
            -- انتظار ذكي (لا يغادر إلا عند اكتمال الطهي)
            repeat 
                task.wait(0.5)
                local status = grill:GetAttribute("cooked_status")
            until status == "Cooked" or status == "Perfect" or status == "Overcooked"
        end
    end
end

