-- دوال البحث عن الكائنات
-- ========================================

local function FindSteakFridge()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "SteakFridge" then
            return obj
        end
    end
    return nil
end

local function FindAvailableGrill()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "SteakGrill" then
            local userId = obj:GetAttribute("user_id_assigned") or 0
            if userId == 0 then
                return obj
            end
        end
    end
    return nil
end

local function FindGrillArea(grill)
    if not grill then return nil end
    for _, part in pairs(grill:GetDescendants()) do
        if part.Name == "GrillArea" and part:IsA("BasePart") then
            return part
        end
    end
    return nil
end

-- ========================================
-- وظيفة الستيك الرئيسية
-- ========================================

local function SteakFarm()
    print("🥩 بدء وظيفة الستيك")
    
    local hasMeat = false
    local currentGrill = nil
    
    while Config.SteakFarm do
        task.wait(0.2)
        
        -- ========================================
        -- 1. الإيداع التلقائي
        -- ========================================
        if Config.AutoDeposit then
            local money = GetMoney()
            if money >= Config.DepositThreshold then
                DepositMoney()
            end
        end
        
        -- ========================================
        -- 2. التقديم على الوظيفة
        -- ========================================
        local job = JobNow()
        
        if job ~= "steakhouse_cook" then
            print("📝 جاري التقديم على وظيفة الستيك...")
            
            -- التوجه لموقع التقديم
            local targetPos = Vector3.new(-262.798, 252.909, 343.73)
            local dist = distTo(targetPos)
            
            if dist > 10 then
                print("🚶 جاري التوجه للتقديم...")
                TeleportTo(targetPos, Config.SteakFarm)
                task.wait(0.5)
            end
            
            -- البحث عن الـ Beacon
            local beacon = nil
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and string.find(obj.Name, "SteakHouseBeacon") then
                    beacon = obj
                    break
                end
            end
            
            if beacon then
                pcall(function()
                    Net.send("apply_for_job", beacon)
                    print("✅ تم إرسال طلب التوظيف")
                end)
                task.wait(2)
            else
                print("❌ ما لقيت SteakHouseBeacon")
                task.wait(1)
            end
            continue
        end
        
        -- ========================================
        -- 3. بعد التوظيف - أخذ اللحم من الثلاجة
        -- ========================================
        print("✅ أنت موظف في مطعم الستيك")
        
        -- البحث عن الثلاجة
        local fridge = FindSteakFridge()
        
        if fridge then
            print("📍 تم العثور على الثلاجة")
            
            -- التوجه إلى الثلاجة
            local primaryPart = fridge.PrimaryPart or fridge:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                local distToFridge = distTo(primaryPart.Position)
                
                if distToFridge > 5 then
                    print("🚶 جاري التوجه للثلاجة...")
                    TeleportTo(primaryPart.Position + Vector3.new(0, 2, 0), Config.SteakFarm)
                    task.wait(0.5)
                end
            end
            
            -- 🔥 تفعيل ProximityPrompt الخاص بالثلاجة
            local prompt = fridge:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt then
                print("📦 جاري أخذ اللحم من الثلاجة...")
                pcall(function()
                    fireproximityprompt(prompt)
                    print("✅ تم أخذ اللحم من الثلاجة")
                    hasMeat = true
                end)
                task.wait(0.5)
            else
                print("❌ ما لقيت ProximityPrompt في الثلاجة")
                -- محاولة بديلة
                pcall(function()
                    Net.send("interact", fridge)
                    print("✅ تم إرسال Net.send كبديل")
                    hasMeat = true
                end)
                task.wait(0.5)
            end
        else
            print("❌ ما لقيت الثلاجة (SteakFridge)")
            task.wait(1)
            continue
        end
        
        -- ========================================
        -- 4. تجهيز اللحم (مسكه)
        -- ========================================
        if hasMeat then
            print("🔪 جاري تجهيز اللحم...")
            
            -- البحث عن أداة تقطيع
            local tools = {"SteakKnife", "MeatCleaver", "GrillFork", "Spatula"}
            local hasTool = false
            
            for _, toolName in ipairs(tools) do
                local tool = Backpack:FindFirstChild(toolName) or Character:FindFirstChild(toolName)
                if tool then
                    if tool.Parent == Backpack then
                        Humanoid:EquipTool(tool)
                        print("🔧 تم تجهيز الأداة: " .. toolName)
                    end
                    hasTool = true
                    break
                end
            end
            
            if not hasTool then
                print("⚠️ لا توجد أداة تقطيع، سأبحث...")
                -- روح لأي أداة قريبة
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Tool") and string.find(string.lower(obj.Name), "knife") then
                        local pos = obj:FindFirstChildWhichIsA("BasePart")
                        if pos then
                            TeleportTo(pos.Position, Config.SteakFarm)
                            task.wait(0.5)
                            Humanoid:EquipTool(obj)
                            print("🔧 تم تجهيز الأداة: " .. obj.Name)
                            break
                        end
                    end
                end
            end
            
            task.wait(0.5)
        end
        
        -- ========================================
        -- 5. البحث عن شواية والطهي
        -- ========================================
        local availableGrill = FindAvailableGrill()
        
        if availableGrill then
            print("🔥 تم العثور على شواية فارغة")
            currentGrill = availableGrill
            
            local grillArea = FindGrillArea(availableGrill)
            
            if grillArea then
                local distToGrill = distTo(grillArea.Position)
                
                if distToGrill > 5 then
                    print("🔥 جاري التوجه للشواية...")
                    TeleportTo(grillArea.Position + Vector3.new(0, 2, 0), Config.SteakFarm)
                    task.wait(0.5)
                end
                
                -- محاولة بدء الطهي
                print("⏳ محاولة بدء الطهي...")
                
                -- انتظر شوي عشان اللاعب يثبت
                task.wait(0.5)
                
                -- محاولة بدء الطهي بطرق مختلفة
                local cookingStarted = false
                
                -- الطريقة 1: Net.send
                pcall(function()
                    Net.send("start_grilling_2", availableGrill)
                    print("✅ تم إرسال start_grilling_2")
                end)
                
                -- الطريقة 2: fireproximityprompt على GrillArea
                for _, prompt in pairs(grillArea:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function()
                            fireproximityprompt(prompt)
                            print("✅ تم إرسال fireproximityprompt على GrillArea")
                        end)
                        break
                    end
                end
                
                -- انتظار ظهور شريط التقدم
                local timeout = tick() + 15
                
                while tick() < timeout and Config.SteakFarm do
                    local bar = PlayerGui:FindFirstChild("ProgressBar")
                    if bar then
                        local frame = bar:FindFirstChild("ProgressBarFrame")
                        if frame and frame.Visible then
                            cookingStarted = true
                            print("✅ بدأ الطهي!")
                            break
                        end
                    end
                    task.wait(0.5)
                end
                
                if cookingStarted then
                    -- انتظار انتهاء الطهي
                    timeout = tick() + 35
                    while tick() < timeout and Config.SteakFarm do
                        local bar = PlayerGui:FindFirstChild("ProgressBar")
                        if bar then
                            local frame = bar:FindFirstChild("ProgressBarFrame")
                            if frame and not frame.Visible then
                                print("✅ انتهى الطهي!")
                                hasMeat = false  -- إعادة تعيين
                                break
                            end
                        end
                        task.wait(0.5)
                    end
                else
                    print("❌ لم يبدأ الطهي، سأحاول مرة أخرى")
                    task.wait(2)
                end
            else
                print("❌ ما لقيت GrillArea")
                task.wait(1)
            end
        else
            print("⏳ جميع الشوايات مشغولة، سأنتظر...")
            task.wait(3)
        end
        
        -- ========================================
        -- 6. نظام الحماية - إعادة الميلاد
        -- ========================================
        if Config.Respawn then
            local deathScreen = PlayerGui:FindFirstChild("DeathScreen")
            if deathScreen then
                local holder = deathScreen:FindFirstChild("DeathScreenHolder")
                if holder and holder.Visible then
                    local btn = holder:FindFirstChild("Frame") and
                                holder.Frame:FindFirstChild("RespawnButtonFrame") and
                                holder.Frame.RespawnButtonFrame:FindFirstChild("RespawnButton")
                    if btn then
                        Net.send("death_screen_request_respawn")
                        print("🔄 تم إعادة الميلاد")
                        task.wait(1)
                    end
                end
            end
        end
    end
    
    print("🛑 توقفت وظيفة الستيك")
end

-- ========================================
-- 7. نظام الحماية - Anti Kill
-- ========================================

local antiKillEnabled = false
local undergroundCFrame = nil

local function isDowned()
    local hum = Character:FindFirstChildOfClass("Humanoid")
    return hum and (hum:GetAttribute("HasBeenDowned") or hum:GetAttribute("IsDead") or hum.Health <= 0)
end

local function GetHRP()
    return Character:FindFirstChild("HumanoidRootPart")
end

task.spawn(function()
    while task.wait(0.1) do
        if not antiKillEnabled then continue end
        
        pcall(function()
            if isDowned() then
                local hrp = GetHRP()
                if hrp then
                    if not undergroundCFrame then
                        undergroundCFrame = hrp.CFrame + Vector3.new(0, -55, 0)
                    end
                    hrp.CFrame = undergroundCFrame
                    task.wait(0.05)
                    hrp.CFrame = undergroundCFrame + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10))
                    task.wait(0.05)
                    hrp.CFrame = undergroundCFrame
                end
            else
                if undergroundCFrame then
                    local hrp = GetHRP()
                    if hrp then
                        hrp.CFrame = undergroundCFrame + Vector3.new(0, 55, 0)
                    end
                    undergroundCFrame = nil
                end
            end
        end)
    end
end)

