-- زر الاستئجار
local RentButton = Instance.new("TextButton")
RentButton.Size = UDim2.new(1, -10, 0, 30)
RentButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
RentButton.TextColor3 = Color3.new(1, 1, 1)
RentButton.Text = "Rent Home"
RentButton.Parent = Frame

-- المنطق البرمجي (الحماية والطلب)
local isRenting = false
local Event = game:GetService("ReplicatedStorage").Remotes.Get

RentButton.MouseButton1Click:Connect(function()
    if isRenting then return end
    
    isRenting = true
    RentButton.Text = "Renting..."
    RentButton.BackgroundColor3 = Color3.fromRGB(100, 50, 50)
    
    local success, err = pcall(function()
        local house = workspace.Map.Tiles:GetChildren()[16]:GetChildren()[9].TestTrapHouse
        Event:InvokeServer("rent_home", house)
    end)
    
    if success then
        RentButton.Text = "✅ Rented!"
        RentButton.BackgroundColor3 = Color3.fromRGB(50, 100, 50)
    else
        RentButton.Text = "❌ Failed"
        warn("Rent Error: " .. tostring(err))
    end
    
    task.wait(3)
    isRenting = false
    RentButton.Text = "Rent Home"
    RentButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
end)

-- وظيفة فحص اللحم والشواية (كما اتفقنا)
task.spawn(function()
    while task.wait(0.5) do
        local char = game.Players.LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        if tool then
            HoldingLabel.Text = "Holding: " .. tool.Name
        else
            HoldingLabel.Text = "Holding: Nothing"
        end

        if tool and tool.Name == "Steak" then
            local foundGrill = false
            local GrillsFolder = workspace:FindFirstChild("Grills")
            if GrillsFolder then
                for _, obj in pairs(GrillsFolder:GetChildren()) do
                    if obj:FindFirstChild("Owner") and obj.Owner.Value == game.Players.LocalPlayer.Name then
                        foundGrill = true
                        break
                    end
                end
            end
            GrillLabel.Text = foundGrill and "✅ Grill Found" or "🔍 Searching..."
        else
            GrillLabel.Text = "Grill: Idle"
        end
    end
end)
