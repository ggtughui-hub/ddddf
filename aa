local VehicleSystem = {}

function VehicleSystem:GetVehicleFromType(types)
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return nil end
    
    local Items = PlayerGui:FindFirstChild("Items")
    if not Items then return nil end
    
    local Holder = Items:FindFirstChild("ItemsHolder")
    if not Holder then return nil end
    
    local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return nil end
    
    for _, v in pairs(ScrollingFrame:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemType = v:GetAttribute("ItemType")
            if itemType then
                if types == "Bike" and itemType == "bike" then
                    return v.ItemName and v.ItemName.Text or nil
                elseif types == "Car" and itemType == "car" then
                    return v.ItemName and v.ItemName.Text or nil
                end
            end
        end
    end
    return nil
end

function VehicleSystem:GetVehicleHealth(vehicleName)
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return nil, nil, nil end
    
    local Items = PlayerGui:FindFirstChild("Items")
    if not Items then return nil, nil, nil end
    
    local Holder = Items:FindFirstChild("ItemsHolder")
    if not Holder then return nil, nil, nil end
    
    local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return nil, nil, nil end
    
    for _, v in pairs(ScrollingFrame:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemType = v:GetAttribute("ItemType")
            if itemType and (itemType == "car" or itemType == "bike") then
                local itemName = v:FindFirstChild("ItemName")
                if itemName and itemName.Text == vehicleName then
                    local healthLabel = v:FindFirstChild("ItemHealth")
                    if healthLabel and healthLabel.Text then
                        local current, max = healthLabel.Text:match("(%d+)/(%d+)")
                        return tonumber(current), tonumber(max), v.Name
                    end
                end
            end
        end
    end
    return nil, nil, nil
end

function VehicleSystem:RepairVehicle(uid)
    if not uid then return false end
    
    local repairCost = 1000
    local currentMoney = GetMoney()
    
    if currentMoney < repairCost then
        if ATMMoney() >= repairCost then
            Net.get("transfer_funds", "bank", "hand", repairCost)
            task.wait(0.05)
        else
            return false
        end
    end
    
    Net.get("repair_vehicle", uid)
    task.wait(0.1)
    return true
end

function VehicleSystem:GetMoney()
    return GetMoney()
end

function VehicleSystem:GetCarFromType(types)
    return self:GetVehicleFromType(types)
end

function VehicleSystem:BuyBikeCrate()
    local BIKE_CRATE_COST = 870
    local bikeCrate = Workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates.Interior.Crates["Bike Crate"]
    local touchPart = bikeCrate.Beacon.TouchPart
    
    if GetMoney() < BIKE_CRATE_COST then
        if ATMMoney() >= BIKE_CRATE_COST then
            self:DriveToATM()
            task.wait(0.1)
            local needed = BIKE_CRATE_COST - GetMoney()
            if needed > 0 then
                Net.get("transfer_funds", "bank", "hand", needed)
