-- =================================================================
-- STEAK FARM: الكود المدمج بالكامل (حركة طبيعية + توظيف + طهي)
-- =================================================================

-- 1. نظام الحركة الذكي (Natural Movement)
function Sf:Teleport(destination, speed)
    Config.StopWalking = false
    Config.Running = true
    local Char = game.Players.LocalPlayer.Character
    local RootPart = Char:WaitForChild("HumanoidRootPart")
    local Humanoid = Char:WaitForChild("Humanoid")
    
    local path = PathfindingService:CreatePath({AgentCanJump = true})
    path:ComputeAsync(RootPart.Position, destination)
    
    if path.Status == Enum.PathStatus.Success then
        for _, wp in pairs(path:GetWaypoints()) do
            if Config.StopWalking then break end
            
            -- حركة فيزيائية طبيعية باستخدام Velocity
            while (RootPart.Position - wp.Position).Magnitude > 3 and not Config.StopWalking do
                local dir = (wp.Position - RootPart.Position).Unit
                RootPart.Velocity = dir * (speed or 34)
                Sf:Ac("set_sprinting_1", true)
                if wp.Action == Enum.PathWaypointAction.Jump then Humanoid.Jump = true end
                task.wait()
            end
        end
    end
    Config.Running = false
end

-- 2. دورة العمل المتكاملة (Main Logic)
local function PerformSteakFarm()
    local player = game.Players.LocalPlayer
    
    -- أ. التوظيف التلقائي
    if player:GetAttribute('Job') ~= "steakhouse_cook" then
        Sf:Teleport(STEAK_POS.Apply)
        local beacon = workspace:FindFirstChild("SteakHouseBeacon", true)
        if beacon then Sf:Ac("apply_for_job", beacon) task.wait(1.5) end
    end

    -- ب. أخذ اللحم
    Sf:Teleport(STEAK_POS.Fridge)
    local target = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (v.Parent.Name == "Get Steak" or string.find(string.lower(v.ObjectText), "steak")) then
            target = v break
        end
    end
    if target then fireproximityprompt(target) task.wait(0.5) end

    -- ج. الطهي (باستخدام الشواية المتاحة من السيرفر)
    if player.Character:FindFirstChild("Steak") then
        local grillId = Net.get("get_random_free_grill")
        local grill = ReplicatedStorage.Modules.Core.StatefulObject.grill_class.get(grillId)
        
        if grill and grill.instance then
            Sf:Teleport(grill.instance:GetPivot().Position)
            Sf:Ac("start_grilling_2", grill.instance)
            
            -- انتظار النضج قبل العودة
            repeat 
                task.wait(0.5)
                local status = grill.states.cooked_status.get()
            until status == "Cooked" or status == "Perfect" or status == "Overcooked"
        end
    end
end

-- 3. تفعيل الحلقة (Loop)
task.spawn(function()
    while true do
        if Config.SteakAutoFarm then
            pcall(PerformSteakFarm)
        end
        task.wait(1)
    end
end)
