local function EnsureVehicle()
    local vehicle = GetPlayerVehicle()
    if vehicle then return vehicle end

    local vehicleName = Sf:GetCarFromType(c().VechineType)
    if not vehicleName then
        Sf:BuyBikeCrate()
        task.wait(1)
        vehicleName = Sf:GetCarFromType(c().VechineType)
        if not vehicleName then return nil end
    end

    local checker = Sf:GetInfo(vehicleName)
    if checker[2] and not checker[4] and not checker[5] then
        Net.get("toggle_equip_item", tostring(checker[3]))
        task.wait(1)
    end
    return GetPlayerVehicle()
end

local function EnterVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return false end
    if Humanoid.Sit then return true end

    for _, prompt in pairs(vehicle.PrimaryPart:GetDescendants()) do
        if prompt:IsA('ProximityPrompt') then
            fireproximityprompt(prompt)
            task.wait(0)
        end
    end

    local waitCount = 0
    while not Humanoid.Sit and waitCount < 20 do
        task.wait(0.1)
        waitCount = waitCount + 1
    end
    return Humanoid.Sit
end

local function ExitVehicle()
    if not Humanoid.Sit then return end
    Net.get("exit_seat")
    task.wait(0.3)
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 2, 3)
    end
    task.wait(0.2)
end

local function DriveTo(destination, value)
    local vehicle = GetPlayerVehicle()
    if not vehicle then return false end
    if not EnterVehicle(vehicle) then return false end
    Sf:Drive(vehicle, destination, value)
    return true
end

