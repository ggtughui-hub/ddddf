if game.CoreGui:FindFirstChild("MyESP_GUI") then
    game.CoreGui.MyESP_GUI:Destroy()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local myUsername = LocalPlayer.Name

print("==============================")
print("اسم حسابك الحالي هو: " .. myUsername)
print("==============================")

local espEnabled = false
local activeHighlights = {}

-- الألوان الواضحة
local COLOR_HOUSE = Color3.fromRGB(0, 255, 0)     -- أخضر فاقع للبيت
local COLOR_FARM = Color3.fromRGB(255, 140, 0)     -- برتقالي للـ FarmingPot
local COLOR_OUTLINE = Color3.fromRGB(255, 255, 255) -- أبيض للأطراف

local function createHighlight(target, fillColor)
    if target and not target:FindFirstChild("CustomESP_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "CustomESP_HL"
        hl.Adornee = target
        hl.FillColor = fillColor
        hl.OutlineColor = COLOR_OUTLINE
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = target
        table.insert(activeHighlights, hl)
    end
end

local function clearESP()
    for _, hl in ipairs(activeHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    activeHighlights = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local h = obj:FindFirstChild("CustomESP_HL")
        if h then
            h:Destroy()
        end
    end
end

local function scanAndApplyESP()
    if not espEnabled then return end
    
    local myTargetHouse = nil
    
    -- البحث عن HousingTile ثم الوصول للبيت بدقة
    for _, tile in ipairs(Workspace:GetDescendants()) do
        if tile.Name == "HousingTile" then
            local exterior = tile:FindFirstChild("Exterior", true)
            if exterior then
                local ownerDisplay = exterior:FindFirstChild("OwnerDisplay")
                local bbGui = ownerDisplay and ownerDisplay:FindFirstChild("BillboardGui")
                local ownerLabel = bbGui and bbGui:FindFirstChild("OwnerLabel")
                
                if ownerLabel and ownerLabel:IsA("TextLabel") then
                    if ownerLabel.Text == myUsername or string.find(ownerLabel.Text, myUsername) then
                        -- هنا بدلاً من اختيار الـ Tile كاملة، نختار مجلد Exterior أو نموذج البيت الأساسي فوقه
                        -- غالباً يكون Exterior نفسه أو Model البناء داخل الـ Tile
                        myTargetHouse = exterior.Parent -- أو exterior مباشرة حسب مجسم البيت
                        print("تم العثور على بيتك بنجاح وتحديد مجسم البيت فقط!")
                        break
                    end
                end
            end
        end
    end
    
    if myTargetHouse then
        -- عمل ESP للبيت وحده
        createHighlight(myTargetHouse, COLOR_HOUSE)
        
        -- البحث عن أحواض الزراعة التابعة حصرياً لهذا البيت
        for _, obj in ipairs(myTargetHouse:GetDescendants()) do
            if obj.Name == "FarmingPot" or string.find(obj.Name:lower(), "farmingpot") then
                createHighlight(obj, COLOR_FARM)
            end
        end
    else
        print("لم يتم العثور على بيت يطابق اسمك (" .. myUsername .. ").")
    end
end

-- واجهة المستخدم (الزر)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MyESP_GUI"
ScreenGui.Parent = CoreGui

local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ToggleButton.Position = UDim2.new(0.05, 0, 0.1, 0)
ToggleButton.Size = UDim2.new(0, 160, 0, 50)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = "ESP: OFF"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 20

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

ToggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    
    if espEnabled then
        ToggleButton.Text = "ESP: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        clearESP()
        scanAndApplyESP()
    else
        ToggleButton.Text = "ESP: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        clearESP()
    end
end)
