task.spawn(function()
    while task.wait(1) do
        if not Config.AutoFarmFishing then 
            Sf:ForceStop()
            continue 
        end
        
        pcall(function()
            -- 1. التأكد من وجود سيارة
            local vehicle = EnsureVehicle()
            if not vehicle then return end

            -- 2. جلب المستلزمات
            local fishingLevel = Sf:GetSkill("Fishing")
            local targetRod = Config.FishingRod
            if targetRod == "Smart Select" then
                for _, rod in ipairs(FishingRods) do
                    if fishingLevel >= rod.Level then targetRod = rod.Name; break end
                end
            end
            local targetBait = Config.FishingWormtec
            if targetBait == "Smart Select" then
                for _, bait in ipairs(FishingBaits) do
                    if fishingLevel >= bait.Level then targetBait = bait.Name; break end
                end
            end

            local hasRod, hasBait, rodUid, baitUid, actualRodName, rodEquipped = false, false, nil, nil, targetRod, false
            local Items = PlayerGui:FindFirstChild("Items")
            if Items then
                local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                if Holding then
                    for _, v in pairs(Holding:GetChildren()) do
                        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                            local itemName = v:FindFirstChild("ItemName")
                            if itemName and itemName.Text then
                                local t = string.lower(itemName.Text)
                                if not hasRod and string.find(t, "rod") then
                                    hasRod = true; rodUid = v.Name; actualRodName = itemName.Text
                                    rodEquipped = v:FindFirstChild('ItemEquipped') and v.ItemEquipped.Visible or false
                                end
                                if not hasBait and (string.find(t, "wormtec") or string.find(t, "prawntec")) then
                                    hasBait = true; baitUid = v.Name
                                end
                            end
                        end
                    end
                end
            end

            -- 3. الشراء إذا كان ناقص
            if not hasRod or not hasBait then
                local moneyNeeded = 0
                if not hasRod then
                    for _, rod in ipairs(FishingRods) do if rod.Name == targetRod then moneyNeeded = moneyNeeded + rod.Price break end end
                end
                if not hasBait then
                    for _, bait in ipairs(FishingBaits) do
                        if bait.Name == targetBait then moneyNeeded = moneyNeeded + (bait.Price * Config.FishingBaitAmount); break end
                    end
                end

                -- سحب من ATM
                if Sf:GetMoney() < moneyNeeded then
                    local atm = Sf:FindClosestAvailableATM()
                    if atm then
                        if DriveTo(atm.Area.Position, Config.AutoFarmFishing) then
                            ExitVehicle()
                            task.wait(0.2)
                            local needed = moneyNeeded - Sf:GetMoney()
                            if needed > 0 then Net.get("transfer_funds", "bank", "hand", needed); task.wait(0.5) end
                            EnterVehicle(vehicle)
                        end
                    else
                        task.wait(2)
                        return
                    end
                end

                -- الذهاب للشراء
                if DriveTo(SHOP_DROPOFF, Config.AutoFarmFishing) then
                    ExitVehicle()
                    task.wait(0.2)
                    local shopZone = workspace:WaitForChild("ShopZone_Hardware")
                    Sf:Teleport(shopZone:GetPivot().Position, Config.AutoFarmFishing, 50)
                    task.wait(0.2)
                    if not hasRod then Net.get("purchase_consumable", shopZone, targetRod); task.wait(0.1) end
                    if not hasBait then
                        for i = 1, Config.FishingBaitAmount do Net.get("purchase_consumable", shopZone, targetBait); task.wait(0.05) end
                    end
                    Sf:Teleport(SHOP_DROPOFF, Config.AutoFarmFishing, 50)
                    task.wait(0.2)
                    EnterVehicle(vehicle)
                end
                return
            end

            -- 4. الذهاب للصيد
            if DriveTo(FISHING_SPOT, Config.AutoFarmFishing) then
                ExitVehicle()
                task.wait(0.2)

                if rodUid and baitUid then
                    if not rodEquipped then
                        Net.get("toggle_equip_item", tostring(rodUid))
                        task.wait(0.1)
                        local tool = Backpack:FindFirstChild(actualRodName)
                        if tool and Humanoid then Humanoid:EquipTool(tool); task.wait(0.1) end
                    end
                    Net.get("equip_ammo_on_item", rodUid, baitUid)
                    task.wait(0.1)
                end

                local char = Client.Character
                if char then
                    local rodTool = char:FindFirstChild(actualRodName) or Backpack:FindFirstChild(actualRodName)
                    if rodTool then
                        Net.get("throw_rod", rodTool, Vector3.new(183.10549926757812, 249.84375, -761.474365234375))
                        local timeout = tick() + 30
                        local progressBarVisible = false
                        while Config.AutoFarmFishing and tick() < timeout do
                            task.wait()
                            local sliderGui = PlayerGui:FindFirstChild("SliderMinigame")
                            if sliderGui then
                                local frame = sliderGui:FindFirstChildOfClass("Frame")
                                if frame and frame.Visible then progressBarVisible = true; break end
                            end
                        end
                        if progressBarVisible then
                            task.wait(0.5)
                            Net.send("reel_ended", rodTool, true)
                            task.wait(0.5)
                        end
                    end
                end
            end

            -- 5. بيع الأسماك
            local fishesToSell = {}
            local currentItems = PlayerGui:FindFirstChild("Items")
            if currentItems then
                local holding = currentItems:FindFirstChild("ItemsHolder") and currentItems.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                if holding then
                    for _, v in pairs(holding:GetChildren()) do
                        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                            local itemType = v:GetAttribute("ItemType")
                            if itemType and string.lower(tostring(itemType)) == "fish" then
                                table.insert(fishesToSell, v.Name)
                            end
                        end
                    end
                end
            end

            if #fishesToSell > 0 then
                if DriveTo(SELL_DROPOFF, Config.AutoFarmFishing) then
                    ExitVehicle()
                    task.wait(0.2)
                    local sellBeacon = workspace:FindFirstChild("SellFishBeacon")
                    if sellBeacon and sellBeacon:FindFirstChild("TouchPart") then
                        Sf:Teleport(sellBeacon.TouchPart.Position, Config.AutoFarmFishing, 50)
                        task.wait(0.2)
                        for _, fUid in ipairs(fishesToSell) do Net.get("sell_item", tostring(fUid), 1); task.wait(0.05) end
                        Sf:Teleport(SELL_DROPOFF, Config.AutoFarmFishing, 50)
                        task.wait(0.2)
                        EnterVehicle(vehicle)
                    end
                end
            end
        end)
    end
end)

