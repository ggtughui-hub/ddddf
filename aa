-- إنشاء نافذة الـ GUI
local CoreGui = game:GetService("CoreGui")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmMonitor"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 220, 0, 90)
Frame.Position = UDim2.new(0.8, 0, 0.1, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local Layout = Instance.new("UIListLayout")
Layout.Parent = Frame
Layout.Padding = UDim.new(0, 5)

-- النصوص
local HoldingLabel = Instance.new("TextLabel")
HoldingLabel.Size = UDim2.new(1, 0, 0.5, 0)
HoldingLabel.BackgroundTransparency = 1
HoldingLabel.TextColor3 = Color3.new(1, 1, 1)
HoldingLabel.Text = "Holding: Nothing"
HoldingLabel.Parent = Frame

local GrillLabel = Instance.new("TextLabel")
GrillLabel.Size = UDim2.new(1, 0, 0.5, 0)
GrillLabel.BackgroundTransparency = 1
GrillLabel.TextColor3 = Color3.new(1, 1, 1)
GrillLabel.Text = "Grill: Idle"
GrillLabel.Parent = Frame

-- المنطق البرمجي (الطلب لمرة واحدة فقط)
local hasRequested = false

task.spawn(function()
    while task.wait(0.5) do
        local char = game.Players.LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        -- تحديث نص الممسوك
        if tool then
            HoldingLabel.Text = "Holding: " .. tool.Name
        else
            HoldingLabel.Text = "Holding: Nothing"
        end

        -- منطق الطلب: إذا كان معك "Steak" ولم نطلب شواية من قبل
        if tool and tool.Name == "Steak" and not hasRequested then
            hasRequested = true -- قفل الطلبات فوراً
            GrillLabel.Text = "Grill: Requesting..."
            
            local success, result = pcall(function()
                return game:GetService("ReplicatedStorage").Remotes.Get:InvokeServer(21, "get_random_free_grill")
            end)
            
            if success and result and result[1] then
                GrillLabel.Text = "✅ Grill Assigned"
            else
                GrillLabel.Text = "❌ Request Failed"
            end
            
        -- إعادة ضبط النظام إذا تركت اللحم
        elseif (not tool or tool.Name ~= "Steak") and hasRequested then
            hasRequested = false
            GrillLabel.Text = "Grill: Idle"
        end
    end
end)
