local SteakFarm = {
    Active = false,
    IsCooking = false,
    HasMeat = false,
    CurrentGrill = nil,
}

-- متغيرات لتخزين الـ Beacon والـ Arrow
local SteakBeacon = nil
local SteakArrow = nil

-- ========================================
-- دالة الحصول على شواية من السيرفر (يدوياً)
-- ========================================
local function GetRandomFreeGrill()
    print("📡 جاري طلب شواية من السيرفر...")
    local assignedGrill = Net.get("get_random_free_grill")
    if assignedGrill then
        print("✅ تم الحصول على شواية من السيرفر!")
        return assignedGrill
    end
    print("❌ لم يتم الحصول على شواية من السيرفر!")
    return nil
end

-- ========================================
-- دالة إنشاء الـ Beacon و Arrow
-- ========================================
local function CreateGrillBeaconAndArrow(grill)
    if not grill then return nil end
    
    -- البحث عن GrillArea
    local grillArea = grill:FindFirstChild("GrillArea")
    if not grillArea then
        print("❌ ما لقيت GrillArea في الشواية")
        return nil
    end
    
    -- حذف الـ Beacon القديم إذا كان موجود
    if SteakBeacon then
        SteakBeacon:Destroy()
        SteakBeacon = nil
    end
    
    -- حذف الـ Arrow القديم إذا كان موجود
    if SteakArrow then
        SteakArrow:Destroy()
        SteakArrow = nil
    end
    
    -- إنشاء Beacon جديد
    SteakBeacon = JobUtil.place_beacon(grillArea.Position - Vector3.new(0, grillArea.Size.Y / 2, 0), true)
    print("📍 تم إنشاء Beacon للشواية")
    
    -- إنشاء Arrow جديد
    SteakArrow = JobUtil.create_arrow(CharModule.get_hrp(), SteakBeacon:FindFirstChildWhichIsA("BasePart"))
    print("📍 تم إنشاء Arrow للتوجيه")
    
    return SteakBeacon
end

-- ========================================
-- دالة التوجه إلى الـ Beacon
-- ========================================
local function WalkToBeacon()
    if not SteakBeacon then
        print("❌ ما فيه Beacon للتوجه إليه")
        return false
    end
    
    local beaconPart = SteakBeacon:FindFirstChildWhichIsA("BasePart")
    if not beaconPart then
        print("❌ ما لقيت BasePart في الـ Beacon")
        return false
    end
    
    local targetPos = beaconPart.Position + Vector3.new(0, 2, 0)
    print("🚶 جاري التوجه إلى الـ Beacon...")
    
    Sf:Teleport(targetPos, Config.SteakAutoFarm)
    task.wait(1)
    
    local dist = distTo(targetPos)
    if dist < 5 then
        print("✅ تم الوصول إلى الـ Beacon")
        return true
    else
        print("⚠️ لم يتم الوصول تماماً")
        return false
    end
end

-- ========================================
-- الدالة الرئيسية - StartSteakFarm
-- ========================================
local function StartSteakFarm()
    print("🥩 بدء فارم Steak...")
    
    while Config.SteakAutoFarm and SteakFarm.Active do
        -- 1. طلب شواية من السيرفر (يدوياً)
        local assignedGrill = GetRandomFreeGrill()
        
        if assignedGrill then
            -- 2. إنشاء Beacon و Arrow
            CreateGrillBeaconAndArrow(assignedGrill)
            
            -- 3. التوجه إلى الـ Beacon
            if SteakBeacon then
                WalkToBeacon()
            end
            
            -- 4. تنظيف
            if SteakBeacon then
                SteakBeacon:Destroy()
                SteakBeacon = nil
            end
            if SteakArrow then
                SteakArrow:Destroy()
                SteakArrow = nil
            end
            
            task.wait(2)
        else
            print("⏳ لم يتم الحصول على شواية، إعادة المحاولة...")
            task.wait(2)
        end
    end
    
    print("🛑 توقف فارم Steak")
end

func['SteakFarm'] = StartSteakFarm

