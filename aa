-- ========================================
-- دوال المساعدة
-- ========================================

local function distTo(v3)
    if not RootPart then return math.huge end
    return (v3 - RootPart.Position).Magnitude
end

local function JobNow()
    return Client:GetAttribute('Job')
end

local function GetMoney()
    local raw = PlayerGui:FindFirstChild("TopRightHud")
    if raw then
        raw = raw:FindFirstChild("Holder")
        if raw then
            raw = raw:FindFirstChild("Frame")
            if raw then
                raw = raw:FindFirstChild("MoneyTextLabel")
                if raw and raw.Text then
                    local stripped = raw.Text:match("%$([%d,]+)")
                    if stripped then
                        return tonumber((stripped:gsub(",", ""))) or 0
                    end
                end
            end
        end
    end
    return 0
end

local function ATMMoney()
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("TextLabel") and string.find(v.Text, "Bank Balance") then
            return tonumber(v.Text:match("%$(%d+)")) or 0
        end
    end
    return 0
end

local function DepositMoney()
    local money = GetMoney()
    if money > 0 then
        Net.get("transfer_funds", "hand", "bank", money)
        task.wait(0.3)
        print("💰 تم إيداع $" .. money)
    end
end

-- ========================================
-- دوال التحرك (Teleport + Pathfinding)
-- ========================================

function TeleportTo(destination, value)
    if not destination or not value then return end
    
    local char = Client.Character or Client.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    local path = PathfindingService:CreatePath({
        AgentCanJump = true,
        AgentJumpHeight = 2.5,
        AgentHeight = 8,
        AgentRadius = 2.5,
        AgentMaxSlope = 90,
        Costs = {BlockedNode = 50, DoorArea = 1}
    })
    
    local success = pcall(function()
        path:ComputeAsync(root.Position, destination)
    end)
    
    if not success or path.Status ~= Enum.PathStatus.Success then
        return
    end
    
    local waypoints = path:GetWaypoints()
    local speed = Config.TeleportSpeed or 45
    
    for _, wp in pairs(waypoints) do
        if not Config.SteakFarm then break end
        
        local offsetY = (wp.Action == Enum.PathWaypointAction.Jump) and 10 or 4
        local targetPos = wp.Position + Vector3.new(0, offsetY, 0)
        local startPos = root.Position
        local dir = (targetPos - startPos).Unit
        local dist = (targetPos - startPos).Magnitude
        local movedDist = 0
        local startTime = tick()
        
        while movedDist < dist and Config.SteakFarm do
            task.wait()
            
            if hum.Health <= 0 then break end
            
            local elapsedTime = tick() - startTime
            movedDist = math.min(elapsedTime * speed, dist)
            local newPos = startPos + dir * movedDist
            
            if hum.Sit then
                hum.Sit = false
            end
            
            root:PivotTo(CFrame.new(newPos))
        end
    end
end

