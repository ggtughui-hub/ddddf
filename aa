if game.CoreGui:FindFirstChild("MyESP_GUI") then
    game.CoreGui.MyESP_GUI:Destroy()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local myUsername = LocalPlayer.Name

print("==============================")
print("اسم حسابك الحالي هو: " .. myUsername)
print("==============================")

local espEnabled = false
local activeHighlights = {}

-- الألوان
local COLOR_HOUSE = Color3.fromRGB(0, 255, 0)     -- أخضر للبيت
local COLOR_FARM = Color3.fromRGB(255, 140, 0)     -- برتقالي للأحواض
local COLOR_OUTLINE = Color3.fromRGB(255, 255, 255) -- أبيض للأطراف

local function createHighlight(target, fillColor)
    if target and not target:FindFirstChild("CustomESP_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "CustomESP_HL"
        hl.Adornee = target
        hl.FillColor = fillColor
        hl.OutlineColor = COLOR_OUTLINE
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = target
        table.insert(activeHighlights, hl)
    end
end

local function clearESP()
    for _, hl in ipairs(activeHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    activeHighlights = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local h = obj:FindFirstChild("CustomESP_HL")
        if h then
            h:Destroy()
        end
    end
end

local function scanAndApplyESP()
    if not espEnabled then return end
    
    local myTargetHouse = nil
    
    -- البحث داخل كل HousingTile في العالم
    for _, tile in ipairs(Workspace:GetDescendants()) do
        if tile.Name == "HousingTile" then
            -- البحث عن أي TextLabel أو قيمة نصية تحتوي على Owned by واسمك
            for _, desc in ipairs(tile:GetDescendants()) do
                if (desc:IsA("TextLabel") or desc:IsA("TextString") or desc:IsA("StringValue")) then
                    local textVal = desc.Text or desc.Value
                    if textVal and (string.find(textVal, "Owned by") or string.find(textVal, "owned by")) and string.find(textVal, myUsername) then
                        -- الوصول إلى مجلد House أو الـ Tile نفسه
                        local current = desc.Parent
                        while current and current ~= tile do
                            if current.Name == "House" then
                                myTargetHouse = current
                                break
                            end
                            current = current.Parent
                        end
                        
                        if not myTargetHouse then
                            myTargetHouse = tile:FindFirstChild("House") or tile
                        end
                        
                        print("تم العثور على بيتك بنجاح عبر التحقق من (Owned by)!")
                        break
                    end
                end
            end
            if myTargetHouse then break end
        end
    end
    
    if myTargetHouse then
        -- تطبيق ESP على البيت
        createHighlight(myTargetHouse, COLOR_HOUSE)
        
        -- تطبيق ESP على أحواض الزراعة التابعة له
        for _, obj in ipairs(myTargetHouse:GetDescendants()) do
            if obj.Name == "FarmingPot" or string.find(obj.Name:lower(), "farmingpot") then
                createHighlight(obj, COLOR_FARM)
            end
        end
    else
        print("لم يتم العثور على نص يتضمن (Owned by) مع اسمك (" .. myUsername .. ") داخل أي HousingTile.")
    end
end

