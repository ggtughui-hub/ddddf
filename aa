function SellFish()
    local fishesToSell = {}
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return false end
    
    local Items = PlayerGui:FindFirstChild("Items")
    if not Items then return false end
    
    local Holder = Items:FindFirstChild("ItemsHolder")
    if not Holder then return false end
    
    local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return false end
    
    for _, v in pairs(ScrollingFrame:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemType = v:GetAttribute("ItemType")
            if itemType and string.lower(tostring(itemType)) == "fish" then
                table.insert(fishesToSell, v.Name)
            end
        end
    end
    
    if #fishesToSell > 0 then
        local sellBeacon = Workspace:FindFirstChild("SellFishBeacon")
        local touchPart = sellBeacon and sellBeacon:FindFirstChild("TouchPart")
        if touchPart then
            local vehicle = GetSpawnedVehicle()
            if Config.UseVehicle and vehicle then
                DriveToLocation(vehicle, touchPart.Position)
            else
                Teleport(touchPart.Position)
            end
            task.wait(0.1)
            
            for _, fUid in ipairs(fishesToSell) do
                Net.get("sell_item", tostring(fUid), 1)
                task.wait(0.05)
            end
            task.wait(0.5)
            return true
        end
    end
    return false
end

function BuyFishingItems(targetRod, targetBait)
    local hasRod = false
    local hasBait = false
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    
    if PlayerGui then
        local Items = PlayerGui:FindFirstChild("Items")
        if Items then
            local Holder = Items:FindFirstChild("ItemsHolder")
            if Holder then
                local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
                if ScrollingFrame then
                    for _, v in pairs(ScrollingFrame:GetChildren()) do
                        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                            local itemName = v:FindFirstChild("ItemName")
                            if itemName and itemName.Text then
                                local t = string.lower(itemName.Text)
                                if not hasRod and string.find(t, "rod") then
                                    hasRod = true
                                end
                                if not hasBait and (string.find(t, "wormtec") or string.find(t, "prawntec")) then
                                    hasBait = true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    local moneyNeeded = 0
    if not hasRod then
        for _, rod in ipairs(FishingRods) do
            if rod.Name == targetRod then
                moneyNeeded = moneyNeeded + rod.Price
                break
            end
        end
    end
    if not hasBait then
        for _, bait in ipairs(FishingBaits) do
            if bait.Name == targetBait then
                moneyNeeded = moneyNeeded + (bait.Price * Config.FishingBaitAmount)
                break
            end
        end
    end
    
    if moneyNeeded > 0 then
        local currentMoney = GetMoney()
        if currentMoney < moneyNeeded then
            local bankMoney = ATMMoney()
            if bankMoney >= (moneyNeeded - currentMoney) then
                local needed = moneyNeeded - currentMoney
                if needed > 0 then
                    DriveToATM()
                    task.wait(0.3)
                    Net.get("transfer_funds", "bank", "hand", needed)
                    task.wait(0.3)
                end
            else
                return false
            end
        end
        
        local shopPos = Vector3.new(-78.403, 251.635, 134.083)
        local vehicle = GetSpawnedVehicle()
        if Config.UseVehicle and vehicle then
            DriveToLocation(vehicle, shopPos)
        else
            Teleport(shopPos)
        end
        task.wait(0.1)
        
        if not hasRod then
            Net.get("purchase_consumable", Workspace:WaitForChild("ShopZone_Hardware"), targetRod)
            task.wait(0.05)
        end
        if not hasBait then
            for i = 1, Config.FishingBaitAmount do
                Net.get("purchase_consumable", Workspace:WaitForChild("ShopZone_Hardware"), targetBait)
                task.wait(0.05)
            end
        end
        return true
    end
    return true
end

function DoFishing()
    local char = Client.Character
    if not char then return end
    
    local PlayerGui = Client:FindFirstChild("PlayerGui")
    if not PlayerGui then return end
    
    local fishingLevel = GetSkill("Fishing")
    
    local targetRod = Config.FishingRod
    if targetRod == "Smart Select" then
        for _, rod in ipairs(FishingRods) do
            if fishingLevel >= rod.Level then
                targetRod = rod.Name
                break
            end
        end
    end
    
    local targetBait = Config.FishingWormtec
    if targetBait == "Smart Select" then
        for _, bait in ipairs(FishingBaits) do
            if fishingLevel >= bait.Level then
                targetBait = bait.Name
                break
            end
        end
    end
    
    if not BuyFishingItems(targetRod, targetBait) then
        return
    end
    
    local rodUid = nil
    local baitUid = nil
    local rodName = nil
    local hasRod = false
    local hasBait = false
    local rodEquipped = false
    
    local Items = PlayerGui:FindFirstChild("Items")
    if Items then
        local Holder = Items:FindFirstChild("ItemsHolder")
        if Holder then
            local ScrollingFrame = Holder:FindFirstChild("ItemsScrollingFrame")
            if ScrollingFrame then
                for _, v in pairs(ScrollingFrame:GetChildren()) do
                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                        local itemName = v:FindFirstChild("ItemName")
                        if itemName and itemName.Text then
                            local t = string.lower(itemName.Text)
                            if not hasRod and string.find(t, "rod") then
                                hasRod = true
                                rodUid = v.Name
                                rodName = itemName.Text
                                local eq = v:FindFirstChild("ItemEquipped")
                                rodEquipped = eq and eq.Visible or false
                            end
                            if not hasBait and (string.find(t, "wormtec") or string.find(t, "prawntec")) then
                                hasBait = true
                                baitUid = v.Name
                            end
                        end
                    end
                end
            end
        end
    end
    
    if not hasRod or not hasBait then
        return
    end
    
    -- Go to fishing spot
    local fishingPos = Vector3.new(184.753616, 254.942337, -751.416321)
    local vehicle = GetSpawnedVehicle()
    if Config.UseVehicle and vehicle then
        DriveToLocation(vehicle, fishingPos)
    else
        Teleport(fishingPos)
    end
    task.wait(0.1)
    
    -- Equip rod
    if rodUid then
        if not rodEquipped then
            Net.get("toggle_equip_item", tostring(rodUid))
            task.wait(0.1)
            
            local backpack = Client:FindFirstChild("Backpack")
            if backpack then
                local tool = backpack:FindFirstChild(rodName)
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if tool and humanoid then
                    humanoid:EquipTool(tool)
                    task.wait(0.05)
                end
            end
        end
        
        if baitUid then
            Net.get("equip_ammo_on_item", rodUid, baitUid)
            task.wait(0.1)
        end
        
        local rodTool = char:FindFirstChild(rodName)
        if rodTool then
            Net.get("throw_rod", rodTool, Vector3.new(183.10549926757812, 249.84375, -761.474365234375))
            
            local timeout = tick() + 30
            local progressBarVisible = false
            
            while Config.AutoFarmFishing and tick() < timeout do
                task.wait()
                local sliderGui = PlayerGui:FindFirstChild("SliderMinigame")
                if sliderGui then
                    local frame = sliderGui:FindFirstChildOfClass("Frame")
                    if frame and frame.Visible then
                        progressBarVisible = true
                        break
                    end
                end
            end
            
            if progressBarVisible then
                task.wait(0.1)
                Net.send("reel_ended", rodTool, true)
            end
        end
    end
end

