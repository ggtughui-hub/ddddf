local Config = {
    AutoSteak = false,
    TeleportSpeed = 34,
    AntiKill = true,
    RemoveDoors = true
}

-- ==========================================
-- 🛠️ 1️⃣ نظام حذف الأبواب والعوائق (Door Remover)
-- ==========================================
local function ClearObstacles()
    if not Config.RemoveDoors then return end
    pcall(function()
        if workspace:FindFirstChild("Map") then
            for _, obj in pairs(workspace.Map:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():find("door") or obj.Name:lower():find("gate") or obj.Name == "Glass") then
                    obj.CanCollide = false
                    obj.Transparency = 0.7
                end
            end
        end
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:find("Door") or obj.Name:find("Gate")) then
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.Transparency = 0.8
                    end
                end
            end
        end
    end)
end

task.spawn(function()
    while task.wait(5) do
        if Config.RemoveDoors then ClearObstacles() end
    end
end)

-- ==========================================
-- 🛡️ 2️⃣ أنظمة الحماية (Anti-Kill / Anti-Stuck)
-- ==========================================
task.spawn(function()
    while task.wait(1) do
        if Config.AntiKill and Humanoid and Humanoid.Health > 0 then
            pcall(function()
                if Humanoid.FloorMaterial == Enum.CellMaterial.Empty and RootPart.Velocity.Y < -100 then
                    RootPart.Velocity = Vector3.new(RootPart.Velocity.X, 0, RootPart.Velocity.Z)
                end
                if RootPart.Position.Y < 200 then
                    RootPart.CFrame = CFrame.new(RootPart.Position.X, 255, RootPart.Position.Z)
                end
            end)
        end
    end
end)

-- ==========================================
-- 🚶‍♂️ 3️⃣ نظام المشي الذكي وحساب النقاط (Pathfinding Teleport)
-- ==========================================
local function TeleportTo(destination)
    if not Config.AutoSteak or Humanoid.Health <= 0 then return end
    
    -- إنشاء المسار الذكي لتفادي التعليق في الجدران
    local path = PathfindingService:CreatePath({
        AgentCanJump = true,
        AgentHeight = 8,
        AgentRadius = 2.5,
        Costs = { DoorArea = 1 }
    })
    
    pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
    
    if path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for _, wp in pairs(waypoints) do
            if not Config.AutoSteak or Humanoid.Health <= 0 then break end
            
            local targetPos = wp.Position + Vector3.new(0, 4, 0) -- رفع النقطة قليلاً لمنع الارتطام بالأرض
            local startPos = RootPart.Position
            local dir = (targetPos - startPos).Unit
            local dist = (targetPos - startPos).Magnitude
            local movedDist = 0
            local startTime = tick()
            
            -- إلغاء اصطدام الشخصية أثناء التنقل الداخلي لحمايتها
            pcall(function()
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end)
            
            while movedDist < dist and Config.AutoSteak do
                task.wait()
                if Humanoid.Sit then Humanoid.Sit = false end
                local elapsedTime = tick() - startTime
                movedDist = math.min(elapsedTime * Config.TeleportSpeed, dist)
                RootPart:PivotTo(CFrame.new(startPos + dir * movedDist))
                NetSend:FireServer(0, "set_sprinting_1", true)
            end
        end
    end
end

local function distTo(v3)
    return (v3 - RootPart.Position).Magnitude
end

-- ==========================================
-- 🥩 4️⃣ اللوب الأساسي لوظيفة الـ Steak فقط
-- ==========================================
task.spawn(function()
    ClearObstacles()
    while task.wait(0.3) do
        if Config.AutoSteak and Humanoid.Health > 0 then
            
            local currentJob = LocalPlayer:GetAttribute('Job')
            if currentJob ~= "steakhouse_cook" then
                print("💼 التوجه لأخذ وظيفة الطاهي...")
                local jobBeacon = Vector3.new(-262.798, 252.909, 343.73)
                if distTo(jobBeacon) > 5 then
                    TeleportTo(jobBeacon)
                else
                    NetSend:FireServer(0, "apply_for_job", workspace.Map.Tiles.ShoppingTile.SteakHouse.Interior.SteakHouseBeacon)
                    task.wait(0.5)
                end
            else
                local hasSteak = Character:FindFirstChild("Raw Steak") or Backpack:FindFirstChild("Raw Steak") or 
                                 Character:FindFirstChild("Steak") or Backpack:FindFirstChild("Steak")
                
                if not hasSteak then
                    local fridgePos = Vector3.new(-279.046, 252.909, 335.229)
                    if distTo(fridgePos) > 4 then
                        TeleportTo(fridgePos)
                        task.wait(0.2)
                    end
                    
                    local fridge = workspace:FindFirstChild("SteakFridge", true)
                    if fridge then
                        local prompt = fridge:FindFirstChildWhichIsA("ProximityPrompt", true) or fridge:FindFirstChild("Interact", true)
                        if prompt then
                            fireproximityprompt(prompt)
                            task.wait(0.2)
                            fireproximityprompt(prompt)
                            task.wait(0.4)
                        end
                    end
                else
                    local success, freeGrill = pcall(function()
                        return NetGet:InvokeServer(14, "get_random_free_grill")
                    end)
                    
                    if success and freeGrill and freeGrill:IsA("Model") then
                        local grillArea = freeGrill:FindFirstChild("GrillArea") or freeGrill:FindFirstChildWhichIsA("BasePart", true)
                        if grillArea then
                            TeleportTo(grillArea.Position + Vector3.new(0, 2, 0))
                            task.wait(0.3)
                            
                            local grillPrompt = freeGrill:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if grillPrompt then
                                fireproximityprompt(grillPrompt)
                            end
                            task.wait(4.5)
                        end
                    else
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") and obj.Name == "SteakGrill" then
                                if (obj:GetAttribute("user_id_assigned") or 0) == 0 then
                                    local grillArea = obj:FindFirstChild("GrillArea") or obj:FindFirstChildWhichIsA("BasePart", true)
                                    if grillArea then
                                        TeleportTo(grillArea.Position + Vector3.new(0, 2, 0))
                                        task.wait(0.4)
                                        local p = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if p then fireproximityprompt(p) end
                                        task.wait(3.5)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
            
        end
    end
end)

