        FarmRunning = false
        if ToggleButton then
            ToggleButton.Text = FarmModule.Config.UI.FarmButtonText
            ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        end
        UpdateUI("🔄 تم إعادة التعيين", Color3.fromRGB(0, 255, 0))
        task.wait(1)
        UpdateUI("⏸️ متوقف", Color3.fromRGB(255, 255, 255))
