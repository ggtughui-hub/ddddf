if game.CoreGui:FindFirstChild("MyESP_GUI") then
    game.CoreGui.MyESP_GUI:Destroy()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local myUsername = LocalPlayer.Name
local myUserId = tostring(LocalPlayer.UserId)

local espEnabled = false
local highlights = {}

print("--- سكربت ESP يعمل ---")
print("اسمك: " + myUsername)

-- إنشاء واجهة المستخدم (GUI)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MyESP_GUI"
ScreenGui.Parent = CoreGui

local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ToggleButton.Position = UDim2.new(0.05, 0, 0.1, 0)
ToggleButton.Size = UDim2.new(0, 160, 0, 50)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = "ESP: OFF"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 20

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

local function createESP(object, fillColor, outlineColor)
    if not object:FindFirstChild("CustomESP_Highlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "CustomESP_Highlight"
        highlight.Adornee = object
        highlight.FillColor = fillColor
        highlight.OutlineColor = outlineColor
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = object
        table.insert(highlights, highlight)
    end
end

local function clearESP()
    for _, highlight in ipairs(highlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    highlights = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local h = obj:FindFirstChild("CustomESP_Highlight")
        if h then
            h:Destroy()
        end
    end
end

local function scanAndApplyESP()
    if not espEnabled then return end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not espEnabled then break end
        
        -- فحص البيوت (HousingTile) بدقة أكبر
        if obj.Name == "HousingTile" or string.find(obj.Name:lower(), "house") or string.find(obj.Name:lower(), "plot") then
            local isMyHouse = false
            
            pcall(function()
                -- التحقق من الـ Attributes
                for _, attr in pairs({obj:GetAttributes()}) do
                    -- إذا وجدنا اسمنا أو الـ ID مخزن كـ Attribute
                    for _, v in pairs(attr) do
                        if tostring(v) == myUsername or tostring(v) == myUserId then
                            isMyHouse = true
                        end
                    end
                end
                
                -- التحقق من الخصائص المباشرة أو القيم الداخلية
                if obj.Name == myUsername or obj.Name == myUserId then
                    isMyHouse = true
                end
            end)
            
            -- فحص الأبناء والـ Values للبحث عن اسمك أو رقمك
            if not isMyHouse then
                for _, descendant in ipairs(obj:GetDescendants()) do
                    if descendant:IsA("StringValue") or descendant:IsA("IntValue") or descendant:IsA("NumberValue") then
                        if tostring(descendant.Value) == myUsername or tostring(descendant.Value) == myUserId then
                            isMyHouse = true
                            break
                        end
                    end
                end
            end

            if isMyHouse then
                createESP(obj, Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 255)) -- أخضر لبيتك
            end
        end

        -- فحص أحواض الزراعة (تأكدنا من فلترتها لتكون دقيقة)
        if obj.Name == "FarmingPot" or obj.Name == "FarmingPots" or string.find(obj.Name:lower(), "farmingpot") then
            -- نتحقق إذا كان الحوض يخصك أو يقع ضمن بيتك (اختياري، حالياً يحدد أحواض الزراعة بشكل عام أو يمكن تخصيصها)
            createESP(obj, Color3.fromRGB(255, 165, 0), Color3.fromRGB(255, 255, 255)) -- برتقالي للزرع
        end
    end
end

ToggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    
    if espEnabled then
        ToggleButton.Text = "ESP: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        scanAndApplyESP()
    else
        ToggleButton.Text = "ESP: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        clearESP()
    end
end)
