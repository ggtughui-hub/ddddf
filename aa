-- ========================
-- 🔒 نظام الحماية (Bypass Protection)
-- ========================

local function SetupBypassProtection()
    pcall(function()
        -- 1. تعطيل Transition UI (شاشة الانتقال)
        local RS = game:GetService("ReplicatedStorage")
        local TransitionModule = require(RS.Modules.Game.UI.TransitionUI)
        if TransitionModule and TransitionModule.transition then
            local old_transition = TransitionModule.transition
            TransitionModule.transition = function(p_in, p_wait, p_out, noLogo)
                return true -- تخطي الانتقال فوراً
            end
            print("✅ Bypass: Transition UI disabled")
        end
    end)

    pcall(function()
        -- 2. تعطيل Character Creator
        local RS = game:GetService("ReplicatedStorage")
        local CharCreator = require(RS.Modules.Game.CharacterCreator.CharacterCreator)
        if CharCreator then
            if CharCreator.start then
                CharCreator.start = function(...)
                    -- تخطي إنشاء الشخصية
                    return true
                end
            end
            if CharCreator.initiate then
                CharCreator.initiate = function(...)
                    -- تخطي التهيئة
                    return true
                end
            end
            print("✅ Bypass: Character Creator disabled")
        end
    end)

    pcall(function()
        -- 3. تعديل ProximityPrompt (المسافات)
        local ATMFolder = workspace:FindFirstChild("Map")
        if ATMFolder then
            ATMFolder = ATMFolder:FindFirstChild("Props")
            if ATMFolder then
                ATMFolder = ATMFolder:FindFirstChild("ATMs")
                if ATMFolder then
                    for _, descendant in pairs(ATMFolder:GetDescendants()) do
                        if descendant:IsA("ProximityPrompt") then
                            descendant.MaxActivationDistance = 25
                            descendant.HoldDuration = 0.1
                        end
                    end
                    print("✅ Bypass: ATM prompts modified")
                end
            end
        end
    end)

    pcall(function()
        -- 4. حذف DoorSystem (للتجول الحر)
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "DoorSystem" or obj.Name == "BasementDoor") then
                obj:Destroy()
                print("✅ Bypass: DoorSystem removed")
            end
        end
    end)

    pcall(function()
        -- 5. تعديل Pathfinding Modifiers (للمشي السلس)
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "DoorSystem" or v.Name == "BasementDoor" then
                for _, x in ipairs(v:GetDescendants()) do
                    if x:IsA('BasePart') then
                        x.CanCollide = false
                        if not x:FindFirstChildOfClass("PathfindingModifier") then
                            local modifier = Instance.new("PathfindingModifier")
                            modifier.Label = "DoorArea"
                            modifier.PassThrough = true
                            modifier.Parent = x
                        end
                    end
                end
            end
            if v.Name == "VehicleBlockers" then
                v:Destroy()
            end
        end
        print("✅ Bypass: Pathfinding modifiers set")
    end)

    pcall(function()
        -- 6. حذف المقاعد غير المحمية (لمنع الدخول للسيارات العشوائية)
        local VehiclesFolder = workspace:FindFirstChild("Vehicles")
        if VehiclesFolder then
            local protectedVehicles = {}
            for _, model in ipairs(VehiclesFolder:GetDescendants()) do
                if model:IsA("VehicleSeat") and model.Name == "DriverSeat" then
                    local vehicle = model:FindFirstAncestorOfClass("Model")
                    if vehicle then
                        protectedVehicles[vehicle] = true
                    end
                end
            end

            local function isProtectedSeat(seat)
                local vehicle = seat:FindFirstAncestorOfClass("Model")
                return vehicle and protectedVehicles[vehicle] == true
            end

            for _, seat in ipairs(workspace:GetDescendants()) do
                if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
                    if not isProtectedSeat(seat) then
                        seat:Destroy()
                    end
                end
            end
            print("✅ Bypass: Unprotected seats removed")
        end
    end)

    pcall(function()
        -- 7. حظر Remote "crashed_car"
        local SendRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Send")
        local oldFireServer = hookfunction(SendRemote.FireServer, function(self, ...)
            local args = {...}
            if args[2] == "crashed_car" then
                return nil
            end
            return oldFireServer(self, ...)
        end)
        print("✅ Bypass: crashed_car remote blocked")
    end)

    pcall(function()
        -- 8. تعطيل مطابقة Version Check
        local VersionModule = require(ReplicatedStorage.Modules.Core.Version)
        if VersionModule and VersionModule.check_version then
            VersionModule.check_version = function()
                return true
            end
            print("✅ Bypass: Version check bypassed")
        end
    end)

    pcall(function()
        -- 9. منع اكتشاف الـ Executor
        if getgenv then
            getgenv().identifyexecutor = nil
        end
        if getfenv then
            local env = getfenv()
            env.identifyexecutor = nil
        end
        print("✅ Bypass: Executor detection disabled")
    end)

    print("🛡️ جميع أنظمة الحماية تم تفعيلها!")
end

