                    print("   📋 محتويات BillboardGui:")
                    for _, child in pairs(billboardGui:GetChildren()) do
                        print("      - " .. child.Name .. " (" .. child.ClassName .. ")")
                        if child:IsA("TextLabel") then
                            print("        النص: '" .. child.Text .. "'")
