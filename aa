-- 🔒 تفعيل نظام الحماية أولاً
SetupBypassProtection()

-- إنشاء الواجهة
CreateUI()

-- مراقبة تغيير الشخصية
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    if FarmRunning then
        FarmRunning = false
        CleanupGrill()
        UpdateUI("تم إيقاف الفارم (تغيير الشخصية)", Color3.fromRGB(255, 0, 0))
        if ToggleButton then
            ToggleButton.Text = FarmModule.Config.UI.FarmButtonText
            ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        end
    end
end)

print("🍽️ سكربت فارم الستيك مع نظام الحماية تم تحميله!")
print("🚶 سيمشي اللاعب تلقائياً إلى الشواية ويبدأ الطهي.")
print("🛡️ جميع أنظمة الحماية (Bypass) مفعلة!")
print("💡 اضغط على 'تشغيل الفارم' للبدء.")
