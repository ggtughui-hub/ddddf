local function GetNearThing(folder, path, condition)
	local closest, shortestDist = nil, math.huge
	if not folder then return nil end
	for _, obj in ipairs(folder:GetChildren()) do
		if string.find(obj.Name, path) then
			if not condition or condition(obj) then
				local dist = math.huge
				if obj:IsA("BasePart") then dist = distTo(obj.Position)
				elseif obj:IsA('Model') and obj.PrimaryPart then dist = distTo(obj.PrimaryPart.Position) end
				if dist < shortestDist then closest = obj; shortestDist = dist end
			end
		end
	end
	return closest
end

local function Getunpack(parent, callback)
	for i, v in pairs(parent:GetChildren()) do pcall(callback, v, i) end
end

local function FindItem(name)
	local t = Backpack:FindFirstChild(name) or Character:FindFirstChild(name)
	return {t ~= nil, t}
end

local StateController = { JobSystemActive = false, JobCoroutine = nil, LastDepositTime = 0 }

function StateController:StopJob()
	self.JobSystemActive = false
	Config.StartFarmJob = false
	if self.JobCoroutine then
		pcall(task.cancel, self.JobCoroutine)
		self.JobCoroutine = nil
	end
	Sf:ForceStop()
end

function StateController:StartJob()
	if self.JobSystemActive then return end
	self.JobSystemActive = true
	Config.StartFarmJob = true
	self.JobCoroutine = task.spawn(function()
		if func['StartFarmJob'] then func['StartFarmJob']() end
	end)
end

local JANITOR_ATM_CFRAME = CFrame.new(179.275848, 255.290543, -247.853378)
local LOCKED_ATM_MAP = { ["Janitor"] = JANITOR_ATM_CFRAME }

local function GetAllATM()
	local all = {}
	for _, atm in pairs(workspace.Map.Props.ATMs:GetChildren()) do
		if atm.Name == "ATM" and atm:IsA("Model") then table.insert(all, atm) end
	end
	return all
end

local function GetDepositATMPos()
	if Config.AutoDepositJob then
		local cf = LOCKED_ATM_MAP[Config.SelectedJob]
		if cf then return cf.Position end
	end
	local shortestDist, atmPos = math.huge, nil
	for _, atm in ipairs(GetAllATM()) do
		local pos = atm.PrimaryPart and atm.PrimaryPart.Position
		if pos then
			local d = distTo(pos)
			if d < shortestDist then shortestDist = d; atmPos = pos end
		end
	end
	return atmPos
end

local function CheckAndDeposit()
	if not Config.AutoDepositJob then return end
	local handMoney = Sf:GetMoney()
	if handMoney < Config.DepositThreshold then return end
	if tick() - StateController.LastDepositTime < 30 then return end
	
	local atmPos = GetDepositATMPos()
	if atmPos then
		local timeout = tick() + 15
		while distTo(atmPos) > 8 and tick() < timeout and Config.StartFarmJob do
			Sf:Teleport(atmPos, Config.StartFarmJob)
			task.wait(0.5)
		end
		local amt = Sf:GetMoney()
		if amt > 0 then
			Net.get("transfer_funds", "hand", "bank", amt)
			task.wait(0.5)
			StateController.LastDepositTime = tick()
		end
	end
end

local function FindBestTool(jobType)
	if jobType == "Janitor" then
		for _, toolName in ipairs({"Silver Mop","Gold Mop","Diamond Mop","Bronze Mop","Mop"}) do
			if Backpack:FindFirstChild(toolName) or Character:FindFirstChild(toolName) then return toolName end
		end
		return "Mop"
	end
	return nil
end

function Sf:dist(Objective) return (Objective.Position - RootPart.Position).Magnitude or 0 end
function Sf:GetMoney()
	local raw = PlayerGui.TopRightHud.Holder.Frame.MoneyTextLabel.Text
	local stripped = raw:match("%$([%d,]+)")
	if not stripped then return 0 end
	return tonumber((stripped:gsub(",", ""))) or 0
end
function Sf:Ac(...) return Net.send(...) end
function Sf:ForceStop()
	if c and c().Running then
		c().StopWalking = true; task.wait(); c().StopWalking = false
	end
end

function Sf:Teleport(destination, value, t, speed)
	Config.StopWalking = false
	Config.Running = true
	local path = PathfindingService:CreatePath({ AgentCanJump = true, Costs = {DoorArea = 1} })
	pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
	
	if path.Status == Enum.PathStatus.Success then
		for _, wp in pairs(path:GetWaypoints()) do
			local offsetY = (wp.Action == Enum.PathWaypointAction.Jump) and 10 or 4
			local targetPos = wp.Position + Vector3.new(0, offsetY, 0)
			local startPos = RootPart.Position
			local dir = (targetPos - startPos).Unit
			local dist = (targetPos - startPos).Magnitude
			local movedDist = 0
			local spd = speed or 34
			local startTime = tick()
			
			while movedDist < dist and not Config.StopWalking and value do
				task.wait()
				if Humanoid.Health <= 0 or not value then break end
				movedDist = math.min((tick() - startTime) * spd, dist)
				RootPart:PivotTo(CFrame.new(startPos + dir * movedDist))
				if Humanoid.Sit then Humanoid.Sit = false end
				Net.send("set_sprinting_1", true)
			end
			if not value then break end
		end
	end
	Config.Running = false
end

