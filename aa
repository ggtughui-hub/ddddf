-- دالة البحث عن الشواية الخاصة بك (تعديل المسار حسب لعبتك)
local function findMyGrill()
    -- نفترض أن الشوايات موجودة في مجلد داخل Workspace
    local GrillsFolder = workspace:FindFirstChild("Grills") 
    if GrillsFolder then
        for _, grill in pairs(GrillsFolder:GetChildren()) do
            -- هنا نبحث عن الشواية التي تملك اسمك أو خاصية مرتبطة بك
            if grill:FindFirstChild("Owner") and grill.Owner.Value == game.Players.LocalPlayer.Name then
                return grill
            end
        end
    end
    return nil
end

-- المنطق: فحص مستمر
task.spawn(function()
    while task.wait(0.5) do
        local char = game.Players.LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        if tool and tool.Name == "Get Steak" then
            HoldingLabel.Text = "Holding: Get Steak"
            
            -- البحث عن الشواية
            local myGrill = findMyGrill()
            if myGrill then
                GrillStatus.Text = "Grill: Found (" .. myGrill.Name .. ")"
                GrillStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
            else
                GrillStatus.Text = "Grill: Not Found!"
                GrillStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
            end
        else
            HoldingLabel.Text = "Holding: Nothing"
            GrillStatus.Text = "Grill: Idle"
            GrillStatus.TextColor3 = Color3.new(1, 1, 1)
        end
    end
end)
