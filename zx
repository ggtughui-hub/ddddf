-- دالة تغيير الارتفاع
local function adjustHeight(amount)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local humanoidRootPart = character.HumanoidRootPart
	
	local currentPos = humanoidRootPart.Position
	-- التزويد (موجب) يطرح من محور Y لينزل تحت الأرض، والتنقيص (سالب) يجمع ليرفع للأعلى
	local targetY = currentPos.Y - amount
	
	humanoidRootPart.CFrame = CFrame.new(currentPos.X, targetY, currentPos.Z)
end

-- ربط الأزرار بالوظائف
plusButton.MouseButton1Click:Connect(function()
	adjustHeight(5) -- تزويد 5 (ينزل تحت الأرض)
end)

minusButton.MouseButton1Click:Connect(function()
	adjustHeight(-5) -- تنقيص 5 (يرفع للأعلى)
end)
