function Sf:GetSkill(skillname)
    local OptionsSkill = PlayerGui:FindFirstChild('Skills')
    if not OptionsSkill then
        return 0
    end
    local Holder = OptionsSkill:FindFirstChild('SkillsHolder').SkillsScrollingFrame
    for _, v in pairs(Holder:GetChildren()) do
        if v.Name == "SkillOptionTemplate" then
            if string.find(v:FindFirstChild('SkillTitle').Text, skillname) then
                return tonumber(v:FindFirstChild('SkillTitle').Text:match("%d+"))
            end
        end
    end
    return 0
end

function Sf:GetInfo(itemName)
    local amount, IsHaving, Uid, Using, Drowning = 0, false, nil, false, false
    local Items = PlayerGui:FindFirstChild("Items")
    local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if not Holding then
        return { 0, false, nil, false, false }
    end
    for _, v in pairs(Holding:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local nameLbl = v:FindFirstChild("ItemName")
            if nameLbl and nameLbl.Text == itemName then
                Uid = v.Name
                amount = amount + 1
                IsHaving = true
                Using = v:FindFirstChild('ItemEquipped') and v.ItemEquipped.Visible or false
                Drowning = v:FindFirstChild('DestroyedItemIcon') and v.DestroyedItemIcon.Visible or false
            end
        end
    end
    return { amount, IsHaving, Uid, Using, Drowning }
end

