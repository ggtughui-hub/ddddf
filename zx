local fishAutoDropEnabled = false

local function dropFishItem(guid)
    if not guid then return end
    pcall(function() Net.send("drop_item", guid, 1) end)
    pcall(function() Net.get("drop_item", guid, 1) end)
end

local function autoDropFish()
    if not fishAutoDropEnabled then return end
    local droppedCount = 0
    pcall(function()
        ItemUtils.iterate_through_items(Data, function(itemData)
            if not itemData or not itemData.guid or not itemData.name then return end
            local itemName = itemData.name
            if fishList[itemName] then
                local itemGuid = itemData.guid
                local itemAmount = itemData.amount or 1
                for i = 1, itemAmount do
                    dropFishItem(itemGuid)
                    task.wait(0.05)
                    droppedCount = droppedCount + 1
                end
            end
        end)
    end)
end

local function applyButtonEffects(button, baseColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = baseColor}):Play()
    end)
end

