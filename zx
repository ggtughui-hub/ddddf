-- استخدام حدث TouchEnded و MouseButton1Down معاً لضمان الاستجابة على الجوال
local function onClick(btn, callback)
    btn.MouseButton1Down:Connect(callback)
    btn.TouchTap:Connect(callback)
end

-- حدث الإغلاق (يحذف السكربت بالكامل)
onClick(CloseButton, function()
    _G.WebhookGuiRunning = nil
    ScreenGui:Destroy()
end)

-- حدث الإرسال
onClick(SendButton, function()
    SendButton.Text = "جاري الإرسال..."
    
    local url = "https://discordapp.com/api/webhooks/1529927605015412827/arArLpMCxMr-n0rOpCFwnI699GUYgXqATDzyKGLTSwbYV5scvO7d9HuCk-qnGtlDAKZ6"
    local data = {["content"] = "test"}
    local body = HttpService:JSONEncode(data)
    
    local requestFunc = request or http_request or syn.request or fluxus and fluxus.request
    
    if requestFunc then
        local success, response = pcall(function()
            return requestFunc({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        end)
        
        if success then
            SendButton.Text = "تم الإرسال بنجاح!"
        else
            SendButton.Text = "فشل الاتصال بالويب!"
        end
    else
        SendButton.Text = "المشغل لا يدعم الـ Request!"
    end
    
    task.wait(2)
    SendButton.Text = "إرسال Test"
end)
