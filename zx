            mobCircleBtn.BackgroundColor3 = Color3.fromRGB(15, 160, 80)
            if not circleDragFrame then
                circleDragFrame = createCircle(screenGui)
            else
                circleDragFrame.Visible = true
            end
        else
            mobCircleBtn.Text = "🎯 إظهار دائرة التصويب [OFF]"
            mobCircleBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
            if circleDragFrame then circleDragFrame.Visible = false end
        end
    end)
