function StartAutoFarm()
    IsFarmingActive = true

    print("🚀 بدء تشغيل Auto Farm!")
    print("================================================")

    task.spawn(function()
        while IsFarmingActive do
            pcall(function()
                local char = Client.Character or Client.CharacterAdded:Wait()
                local backpack = Client:FindFirstChild("Backpack")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                local toolNames = {"FishingRodUltimate", "FishingRodAdvanced", "FishingRodPro", "FishingRodRegular"}
                
                if backpack and humanoid then
                    local mainTool = nil
                    for _, name in ipairs(toolNames) do
                        mainTool = char:FindFirstChild(name) or backpack:FindFirstChild(name)
                        if mainTool then break end
                    end
                    
                    if mainTool and mainTool.Parent == backpack then
                        humanoid:EquipTool(mainTool)
                    end
                end
            end)
            task.wait(2)
        end
    end)

    if AutoBuyToggle.Value then
        print("🛒 [StartAutoFarm] جاري التحقق من المعدات وشراء الناقص...")
        local buySuccess = BuyEquipment()
        if not buySuccess then
            warn("❌ [StartAutoFarm] فشل في شراء المعدات! جاري إعادة المحاولة...")
            task.wait(2)
            BuyEquipment()
        end
        if not IsFarmingActive then return end
    end

    print(" Gunnery [MainLoop] جاري تجهيز السنارة...")
    local equipSuccess = EquipRod()
    if not equipSuccess then
        warn("❌ [StartAutoFarm] فشل في تجهيز السنارة! جاري إعادة المحاولة...")
        task.wait(2)
        equipSuccess = EquipRod()
        if not equipSuccess then
            warn("❌ [StartAutoFarm] فشل مجدداً في تجهيز السنارة! إيقاف الفارم.")
            IsFarmingActive = false
            return
        end
    end
    if not IsFarmingActive then return end

    while IsFarmingActive do
        if isProtectionTriggered then
            print("🛑 [الفارم] الحماية مفعلة - انتظار حتى تزول...")
            while isProtectionTriggered and IsFarmingActive do
                task.wait(0.5)
            end
            if not IsFarmingActive then break end
            continue
        end
        
        if not EnsureRodEquipped() then
            print("⚠️ السنارة غير مجهزة! جاري إعادة التجهيز...")
            EquipRod()
            if not IsFarmingActive then break end
        end
        
        local zone = ZoneDropdown.Value
        local data = Zones[zone]
        if not data then
            task.wait(1)
            continue
        end

        local inventoryCount = Sf:GetInventoryCount()
        print("🎒 [MainLoop] عدد العناصر في الإنونتوري: " .. inventoryCount .. "/17")

        local hasBait, baitName, baitUid = Sf:HasAnyBait()

        if inventoryCount >= 17 or not hasBait then
            print("⚠️ [MainLoop] الحقيبة ممتلئة أو انتهى الطعم! بدء عملية البيع...")
            RootPart.Anchored = false

            local fishCount = Sf:GetFishCount()
            if fishCount > 0 then
                print("🐟 [MainLoop] يوجد " .. fishCount .. " سمكة للبيع")
                
                local sellSuccess = Sf:SellFishWithPath()
                if not sellSuccess then
                    warn("❌ [MainLoop] فشل في عملية البيع بالمسار المخصص! جاري المحاولة بالطريقة العادية...")
                    Sf:Teleport(SellBeaconPos, true, 25)
                    task.wait(0.5)
                    Sf:SellAllFish()
                end
                task.wait(0.5)
            else
                print("🐟 [MainLoop] لا توجد أسماك للبيع.")
            end

            print("🏦 [MainLoop] جاري إيداع الفلوس...")
            local depositSuccess = DepositAllMoney()
