    sendBtn.TextSize = 13
    sendBtn.Parent = rFrame
    Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0, 8)

    sendBtn.MouseButton1Click:Connect(function()
        local currentTime = os.time()
        if currentTime - lastReportTime < REPORT_COOLDOWN then
            local timeLeft = math.ceil((REPORT_COOLDOWN - (currentTime - lastReportTime)) / 60)
            showEffect("⏳ عذراً! يمكنك إرسال بلاغ آخر بعد " .. timeLeft .. " دقيقة.", "error")
            return
        end

        if textBox.Text == "" or #textBox.Text < 5 then
            showEffect("❌ الرجاء كتابة وصف حقيقي للمشكلة أولاً!", "error")
            return
        end

        local problemDescription = textBox.Text
        sendBtn.Text = "⏳ جاري الإرسال..."
        sendBtn.Active = false

        task.spawn(function()
            local success, _ = pcall(function()
                local payload = HttpService:JSONEncode({
                    ["username"] = "report",
                    ["embeds"] = {{
                        ["title"] = "🚨 بلاغ عن مشكلة جديدة في السكربت",
                        ["color"] = 16726824,
                        ["fields"] = {
                            {["name"] = "👤 اسم الشخص (Username)", ["value"] = LocalPlayer.Name, ["inline"] = true},
                            {["name"] = "⚙️ نوع الجهاز المختار", ["value"] = deviceTypeString, ["inline"] = true},
                            {["name"] = "📝 وصف المشكلة", ["value"] = problemDescription, ["inline"] = false}
                        },
                        ["footer"] = {["text"] = "تاريخ البلاغ: " .. os.date("%Y-%m-%d %X")}
                    }}
                })
                
                if request then
                    request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
                elseif syn and syn.request then
                    syn.request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
                end
            end)

            if success then
                lastReportTime = currentTime
                textBox.Text = ""
                rFrame.Visible = false
                showEffect("✅ تم إرسال البلاغ لطاقم العمل بنجاح!", "success")
            else
                showEffect("❌ فشل الإرسال، تحقق من اتصال المشغل الخاص بك.", "error")
            end
            sendBtn.Text = "🚀 إرسال البلاغ الآن"
            sendBtn.Active = true
        end)
    end)

    return rFrame
end

