                    if rodTool then
                        pcall(function()
                            Net_upvr.send("reel_ended", rodTool, false)
                        end)
                    end
                    break
                end
                
                task.wait(0.1)
                local sliderGui = PlayerGui:FindFirstChild("SliderMinigame")
                if (sliderGui and sliderGui:FindFirstChildOfClass("Frame") and sliderGui:FindFirstChildOfClass("Frame").Visible) or isSliderOpen() then
                    progressBarVisible = true
                    print("🎯 تم اكتشاف السلايدر!")
                    break
                end
            end

            if isProtectionTriggered then
                continue
            end

            if progressBarVisible then
                task.wait(0.3)
                
                if QuickWin() then
                    print("✅ [MainLoop] تم صيد سمكة!")
                end
                
                if rodTool then
                    pcall(function()
                        Net_upvr.send("reel_ended", rodTool, true)
                    end)
                end
            else
                print("⏰ [MainLoop] انتهى وقت الانتظار، جاري إعادة الرمي...")
                if rodTool then
                    pcall(function()
                        Net_upvr.send("reel_ended", rodTool, false)
                    end)
                end
            end
        end

        task.wait(1)
    end
    
    RootPart.Anchored = false
    currentPath = nil
    pathWaypoints = {}
    currentWaypointIndex = 0
    print("🛑 تم إيقاف Auto Farm")
    print("================================================")
