-- ==========================================
-- نظام الحماية (معدل إلى ثانيتين)
-- ==========================================
local function SetupNotificationMonitor()
    local SendRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Send")
    
    SendRemote.OnClientEvent:Connect(function(eventName, ...)
        if eventName == "notification" then
            local args = {...}
            local message = args[2] or ""
            
            if message:find("Anti noclip triggered") or message:find("Teleport detected") then
                if Config.AutoFarmFishing then
                    task.spawn(function()
                        print("🛡️ تم اكتشاف حماية! إيقاف الفارم لمدة ثانيتين...")
                        Config.Paused = true
                        Config.StopWalking = true
                        task.wait(2)  -- ✅ تغيير إلى ثانيتين
                        Config.Paused = false
                        Config.StopWalking = false
                        print("✅ استئناف الفارم...")
                    end)
                end
            end
        end
    end)
end

-- ==========================================
-- دالة الإيداع المعدلة
-- ==========================================
local function CheckAndDeposit()
    if not Config.AutoDepositJob then return end
    local handMoney = Sf:GetMoney()
    if handMoney < Config.DepositThreshold then return end
    
    print("💰 بدء عملية الإيداع... المبلغ: $" .. handMoney)
    
    local shortestDist, atmPos = math.huge, nil
    local ATMFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
    
    if ATMFolder then
        for _, atm in ipairs(ATMFolder:GetChildren()) do
            if atm.Name == "ATM" and GetAtmIsNotHackedJob(atm) then
                local pos = atm.PrimaryPart and atm.PrimaryPart.Position
                if not pos then
                    for _, part in ipairs(atm:GetDescendants()) do
                        if part:IsA("BasePart") then pos = part.Position break end
                    end
                end
                if pos then
                    local d = (pos - RootPart.Position).Magnitude
                    if d < shortestDist then 
                        shortestDist = d 
                        atmPos = pos 
                    end
                end
            end
        end
    end

    if atmPos then
        local timeout = tick() + 15
        while (atmPos - RootPart.Position).Magnitude > 8 and tick() < timeout and Config.AutoFarmFishing and not Config.Paused do
            Sf:Teleport(atmPos, Config.AutoFarmFishing)
            task.wait(0.5)
        end
        
        local amt = Sf:GetMoney()
        if amt > 0 then
            Net.get("transfer_funds", "hand", "bank", amt)
            task.wait(0.5)
            print("✅ تم إيداع $" .. amt)
        end
    end
end

-- ==========================================
-- دالة شراء المستلزمات (مع الإيداع أولاً)
-- ==========================================
local function BuySupplies(targetRod, targetBait, hasRod, hasBait)
    local baitAmt = Config.FishingBaitAmount or 1
    
    -- ✅ حساب المبلغ المطلوب
    local moneyNeeded = 0
    if not hasRod then
        for _, rod in ipairs(FishingRods) do
            if rod.Name == targetRod then 
                moneyNeeded = moneyNeeded + rod.Price 
                break 
            end
        end
    end
    if not hasBait then
        for _, bait in ipairs(FishingBaits) do
            if bait.Name == targetBait then 
                moneyNeeded = moneyNeeded + (bait.Price * baitAmt) 
                break 
            end
        end
    end
    
    -- ✅ أولاً: إيداع الفلوس الزائدة (إذا كان معه أكثر من المطلوب)
    local currentMoney = Sf:GetMoney()
    if currentMoney > moneyNeeded + Config.DepositThreshold then
        print("💰 يوجد فلوس زائدة، يتم الإيداع أولاً...")
        CheckAndDeposit()
        task.wait(0.5)
    end
    
    -- ✅ ثانياً: التأكد من وجود فلوس كافية للشراء
    while Sf:GetMoney() < moneyNeeded and Config.AutoFarmFishing do
        if Config.Paused then 
            task.wait(1) 
            continue 
        end
        
        print("🏧 سحب فلوس من البنك... المبلغ المطلوب: $" .. moneyNeeded)
        
        local shortestDist = math.huge
        local atmPos = nil
        local targetAtm = nil
        local ATMFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
        
        if ATMFolder then
            for _, atm in ipairs(ATMFolder:GetChildren()) do
                if atm.Name == "ATM" and GetAtmIsNotHackedJob(atm) then
                    local pos = atm.PrimaryPart and atm.PrimaryPart.Position
                    if not pos then
                        for _, part in ipairs(atm:GetDescendants()) do
                            if part:IsA("BasePart") then pos = part.Position break end
                        end
                    end
                    if pos then
                        local d = (pos - RootPart.Position).Magnitude
                        if d < shortestDist then
                            shortestDist = d
                            atmPos = pos
                            targetAtm = atm
                        end
                    end
                end
            end
        end
        
        if not atmPos then
            atmPos = Vector3.new(179.200882, 255.290543, -236.355896)
        end
        
        if atmPos then
            local reached = false
            local monitorThread = task.spawn(function()
                while not reached and Config.AutoFarmFishing do
                    task.wait(0.2)
                    if targetAtm and not GetAtmIsNotHackedJob(targetAtm) then
                        Sf:ForceStop()
                        break
                    end
                end
            end)
            
            Sf:Teleport(atmPos, Config.AutoFarmFishing)
            reached = true
            
            if (targetAtm and GetAtmIsNotHackedJob(targetAtm)) or not targetAtm then
                local hrp = Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - atmPos).Magnitude < 25 then
                    local needed = moneyNeeded - Sf:GetMoney()
                    if needed > 0 then
                        Net.get("transfer_funds", "bank", "hand", needed)
                        task.wait(0.5)
                        print("✅ تم سحب $" .. needed .. " من البنك")
                    end
                end
            end
        else
            task.wait(1)
        end
    end
    
    -- ✅ ثالثاً: الذهاب للمتجر والشراء
    local shopPos = Vector3.new(-136.406662, 254.851074, 153.555588)
    Sf:Teleport(shopPos, Config.AutoFarmFishing)
    task.wait(0.01)
    
    if not hasRod then
        Net.get("purchase_consumable", workspace:WaitForChild("ShopZone_Hardware"), targetRod)
        task.wait(0.01)
        print("🎣 تم شراء: " .. targetRod)
    end
    
    if not hasBait then
        local baitAmt = Config.FishingBaitAmount or 1
        for i = 1, baitAmt do
            Net.get("purchase_consumable", workspace:WaitForChild("ShopZone_Hardware"), targetBait)
            task.wait(0.05)
        end
        print("🪱 تم شراء " .. baitAmt .. " من: " .. targetBait)
    end
end
