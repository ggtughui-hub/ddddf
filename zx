local function StartAutoFarm()
    if autoFarmActive then return end
    autoFarmActive = true
    showEffect("⚡ تشغيل الأوتو اللانهائي ⚡", "success")
    
    autoFarmThread = task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
        task.wait(0.4)
        CastRod()
        
        while autoFarmActive do
            if isSliderOpen() then
                QuickWin()
                while autoFarmActive and isSliderOpen() do task.wait(0.01) end
                task.wait(1.0)
                if autoFarmActive then CastRod() end
            end
            task.wait(0.01)
        end
    end)
end

local function StopAutoFarm()
    if not autoFarmActive then return end
    autoFarmActive = false
    if autoFarmThread then task.cancel(autoFarmThread); autoFarmThread = nil end
    showEffect("⏹️ تم إيقاف الأوتو فارم", "error")
end

local function ToggleAutoFarm()
    if autoFarmActive then StopAutoFarm() else StartAutoFarm() end
end

