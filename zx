-- قم بنسخ هذا الكود ولصقه مباشرة في محقن Delta داخل اللعبة

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- التأكد من عدم تكرار الواجهة إذا تم تشغيل السكربت أكثر من مرة
if playerGui:FindFirstChild("DeltaUndergroundGui") then
	playerGui.DeltaUndergroundGui:Destroy()
end

-- إنشاء واجهة المستخدم (GUI)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DeltaUndergroundGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 50)
frame.Position = UDim2.new(0.5, -130, 0.75, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- النص التوضيحي داخل الشريط
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "اسحب لليمين للنزول تحت الأرض"
label.TextColor3 = Color3.fromRGB(200, 200, 200)
label.TextSize = 14
label.Font = Enum.Font.SourceSansBold
label.Parent = frame

-- زر السحب (Slider Button)
local sliderButton = Instance.new("TextButton")
sliderButton.Size = UDim2.new(0, 50, 1, 0)
sliderButton.Position = UDim2.new(0, 0, 0, 0)
sliderButton.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
sliderButton.Text = "|||"
sliderButton.TextColor3 = Color3.fromRGB(255, 255, 255)
sliderButton.TextSize = 18
sliderButton.Font = Enum.Font.SourceSansBold
sliderButton.Parent = frame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 10)
btnCorner.Parent = sliderButton

-- منطق السحب المتوافق مع الجوال (Touch & Mouse)
local userInputService = game:GetService("UserInputService")
local dragging = false
local dragInput, mousePos, framePos

sliderButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		mousePos = input.Position
		framePos = sliderButton.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

userInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		local humanoidRootPart = character.HumanoidRootPart
		
		local delta = input.Position - mousePos
		local maxDistance = frame.AbsoluteSize.X - sliderButton.AbsoluteSize.X
		local newX = math.clamp(framePos.X.Offset + delta.X, 0, maxDistance)
		
		sliderButton.Position = UDim2.new(0, newX, 0, 0)
		
		-- حساب النسبة (من 0 إلى 1) وإنزال اللاعب تدريجياً تحت الأرض
		local percentage = newX / maxDistance
		local currentPos = humanoidRootPart.Position
		local targetY = - (percentage * 100) -- أقصى نزول 100 خطوة تحت الأرض
		
		humanoidRootPart.CFrame = CFrame.new(currentPos.X, targetY, currentPos.Z)
	end
end)
