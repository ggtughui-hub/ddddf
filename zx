                continue
            end

            if not EnsureRodEquipped() then
                print("⚠️ [MainLoop] السنارة غير مجهزة! جاري إعادة التجهيز...")
                EquipRod()
                if not IsFarmingActive then break end
                continue
            end

            RootPart.Anchored = true
            task.wait(0.2)

            print(" Gunnery [MainLoop] جاري تركيب الطعم على السنارة...")
