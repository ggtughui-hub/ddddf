-- دالة لإرسال الرسالة إلى Discord Webhook (متوافقة مع دلتا)
local function SendWebhookMessage(message)
    local success, err = pcall(function()
        local data = {["content"] = message}
        local body = HttpService:JSONEncode(data)
        
        -- محاولة استخدام request بأشكاله المختلفة
        local requestFunc = syn and syn.request or fluxus and fluxus.request or http_request or request
        
        if requestFunc then
            requestFunc({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        else
            -- محاولة استخدام game:HttpGet مع POST
            local success2, err2 = pcall(function()
                game:HttpGet(WEBHOOK_URL, true, body)
            end)
            if not success2 then
                warn("❌ فشل الإرسال عبر HttpGet: " .. tostring(err2))
            end
        end
    end)
    
    if not success then
        warn("❌ Failed to send webhook: " .. tostring(err))
    else
        print("✅ Webhook sent successfully!")
    end
end

