local function GetAtmIsNotHackedJob(atm)
if not atm then return false end
local keys = {}
for k in pairs(atm:GetAttributes()) do
table.insert(keys, k)
end
table.sort(keys)
if keys[3] then
return atm:GetAttribute(keys[3]) == false
end
return false
end

local function CheckAndDeposit()
    if not Config.AutoDepositJob then return end
    local handMoney = Sf:GetMoney()
    if handMoney < Config.DepositThreshold then return end
    
    local shortestDist, atmPos = math.huge, nil
    local ATMFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
    
    if ATMFolder then
        for _, atm in ipairs(ATMFolder:GetChildren()) do
            if atm.Name == "ATM" and GetAtmIsNotHackedJob(atm) then
                local pos = atm.PrimaryPart and atm.PrimaryPart.Position
                if not pos then
                    for _, part in ipairs(atm:GetDescendants()) do
                        if part:IsA("BasePart") then pos = part.Position break end
                    end
                end
                if pos then
                    local d = (pos - RootPart.Position).Magnitude
                    if d < shortestDist then 
                        shortestDist = d 
                        atmPos = pos 
                    end
                end
            end
        end
    end

    if atmPos then
        local timeout = tick() + 15
        while (atmPos - RootPart.Position).Magnitude > 8 and tick() < timeout and Config.AutoFarmFishing and not Config.Paused do
            Sf:Teleport(atmPos, Config.AutoFarmFishing)
            task.wait(0.5)
        end
        
        local amt = Sf:GetMoney()
        if amt > 0 then
            Net.get("transfer_funds", "hand", "bank", amt)
            task.wait(0.5)
        end
    end
end

