local Sf = {}
local currentPath = nil
local currentWaypointIndex = 0
local pathWaypoints = {}

function Sf:dist(pos)
    return (pos - RootPart.Position).Magnitude
end

function Sf:GoTo(destination, speed, requiredDistance)
    if isProtectionTriggered then
        print("🛑 [الوصول] الحماية مفعلة - لا يمكن التحرك")
        return false
    end

    local currentDist = Sf:dist(destination)
    if currentDist <= (requiredDistance or 4) then
        print("✅ [الوصول] أنت بالفعل في الموقع (المسافة: " .. string.format("%.1f", currentDist) .. ")")
        return true
    end

    print("🚶 [الوصول] التوجه إلى (المسافة: " .. string.format("%.1f", currentDist) .. ")")
    Sf:Teleport(destination, true, speed or WalkSpeedSlider.Value or 20)
    
    if not IsFarmingActive or Config.StopWalking then
        return false
    end
    
    if isProtectionTriggered then
        print("🛑 [الوصول] تم تفعيل الحماية أثناء التحرك")
        return false
    end

    task.wait(0.5)
    return Sf:dist(destination) <= (requiredDistance or 4)
end

function Sf:Teleport(destination, value, speed)
    if isProtectionTriggered then
        return
    end
    
    Config.StopWalking = false
    Config.Running = true
    local hrp = RootPart

    local path = PathfindingService:CreatePath({
        AgentCanJump = true,
        AgentRadius = 2.5,
        Costs = { BlockedNode = 50, DoorArea = 1 }
    })

    local success = pcall(function()
        path:ComputeAsync(hrp.Position, destination)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        Config.Running = false
        return
    end

    currentPath = path
    pathWaypoints = path:GetWaypoints()
    currentWaypointIndex = 1

    for i, wp in pairs(pathWaypoints) do
        if isProtectionTriggered then
            Config.Running = false
            currentWaypointIndex = i
            print("🛑 [التحرك] تم إيقاف التحرك بسبب الحماية عند النقطة " .. i)
            return
        end
        
        if not IsFarmingActive or Config.StopWalking then
            Config.Running = false
            currentWaypointIndex = i
            return
        end

        currentWaypointIndex = i
        
        local targetPos = wp.Position + Vector3.new(0, 4, 0)
        local startPos = hrp.Position
        local dir = (targetPos - startPos).Unit
        local dist = (targetPos - startPos).Magnitude
        local movedDist = 0
        local spd = speed or WalkSpeedSlider.Value or 20
        local startTime = tick()

        while movedDist < dist and IsFarmingActive and not Config.StopWalking and not isProtectionTriggered do
            task.wait()
            local elapsed = tick() - startTime
            movedDist = math.min(elapsed * spd, dist)
            local newPos = startPos + dir * movedDist

            if Humanoid.Sit then Humanoid.Sit = false end
            hrp:PivotTo(CFrame.new(newPos))
            pcall(function()
                Net_upvr.send("set_sprinting_1", true)
            end)
        end
        
        if isProtectionTriggered then
            Config.Running = false
            return
        end
    end
    Config.Running = false
    currentPath = nil
    pathWaypoints = {}
    currentWaypointIndex = 0
end

