                depositSuccess = DepositAllMoney()
                if not depositSuccess then
                    warn("❌ [MainLoop] فشل مجدداً في الإيداع!")
                end
            end
            if not IsFarmingActive then break end

            hasBait = Sf:HasAnyBait()
            if not hasBait then
