local function GetAtmIsNotHackedJob(atm)
    if not atm then return false end
    local keys = {}
    for k in pairs(atm:GetAttributes()) do
        table.insert(keys, k)
    end
    table.sort(keys)
    if keys[3] then
        return atm:GetAttribute(keys[3]) == false
    end
    return false
end

local function HandMoney()
    local hudLabel = PlayerGui:FindFirstChild("TopRightHud") 
        and PlayerGui.TopRightHud:FindFirstChild("Holder") 
        and PlayerGui.TopRightHud.Holder:FindFirstChild("Frame") 
        and PlayerGui.TopRightHud.Holder.Frame:FindFirstChild("MoneyTextLabel")
    if hudLabel then
        local cleanText = hudLabel.Text:gsub(",", "")
        return tonumber(cleanText:match("%$(%d+)"))
    end
    return 0
end

local CachedBankLabel = nil
local function ATMMoney()
    if CachedBankLabel and CachedBankLabel:IsDescendantOf(PlayerGui) then
        local cleanText = CachedBankLabel.Text:gsub(",", "")
        return tonumber(cleanText:match("%$(%d+)")) or 0
    end
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("TextLabel") and string.find(v.Text, "Bank Balance") then
            CachedBankLabel = v
            local cleanText = v.Text:gsub(",", "")
            return tonumber(cleanText:match("%$(%d+)")) or 0
        end
    end
    return 0
end

local function GetMoney()
    local raw = PlayerGui.TopRightHud.Holder.Frame.MoneyTextLabel.Text
    local stripped = raw:match("%$([%d,]+)")
    if not stripped then return 0 end
    return tonumber((stripped:gsub(",", ""))) or 0
end

local function GetSkill(skillname)
    local OptionsSkill = PlayerGui:FindFirstChild('Skills')
    if not OptionsSkill then return 0 end
    local Holder = OptionsSkill:FindFirstChild('SkillsHolder').SkillsScrollingFrame
    for _, v in pairs(Holder:GetChildren()) do
        if v.Name == "SkillOptionTemplate" then
            if string.find(v:FindFirstChild('SkillTitle').Text, skillname) then
                return tonumber(v:FindFirstChild('SkillTitle').Text:match("%d+"))
            end
        end
    end
    return 0
end

local function GetInfo(w)
    local amount = 0
    local IsHaving = false
    local Uid = nil
    local Using = false
    local Drowning = false
    local Items = PlayerGui.Items
    local Holding = Items:FindFirstChild('ItemsHolder').ItemsScrollingFrame
    for _, v in pairs(Holding:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemName = v:FindFirstChild("ItemName")
            if itemName and itemName.Text == w then
                Uid = v.Name
                amount = amount + 1
                IsHaving = true
                Using = v:FindFirstChild('ItemEquipped').Visible
                Drowning = v:FindFirstChild('DestroyedItemIcon').Visible
            end
        end
    end
    return {amount, IsHaving, Uid, Using, Drowning}
end

