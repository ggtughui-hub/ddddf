function WithdrawSpecificAmount(amount)
    if amount <= 0 then
        return true
    end

    local currentHand = Sf:GetMoney()
    if currentHand >= amount then
        print("✅ يوجد رصيد كافٍ في اليد: $" .. currentHand)
        return true
    end

    local needed = amount - currentHand
    local bankMoney = Sf:GetBankMoney()

    if bankMoney < needed then
        warn("❌ رصيد البنك غير كافٍ! المطلوب: $" .. needed .. "، المتاح: $" .. bankMoney)
        return false
    end

    print("🏦 جاري البحث عن أقرب صراف لسحب: $" .. needed)
    local atm = Sf:FindClosestAvailableATM()
    if not atm then
        warn("❌ لم يتم العثور على صراف متاح!")
        return false
    end

