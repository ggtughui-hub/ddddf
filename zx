-- ==========================================
-- دالة التحقق من امتلاء المخزون بالحد الأقصى
-- ==========================================
function Sf:IsInventoryFull()
    -- نجيب الحد الأقصى للمخزون من السيرفر
    local maxSlots = 0
    local success, result = pcall(function()
        return Net.get("get_max_inventory_space")
    end)
    
    if success and result then
        maxSlots = result.hand or 0
    else
        -- إذا ما قدرت تجيب الحد، استخدم 20 كحد افتراضي
        maxSlots = 20
    end
    
    -- نجيب عدد العناصر الحالية في المخزون
    local currentItems = 0
    local Items = PlayerGui:FindFirstChild("Items")
    if Items then
        local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
        if Holding then
            for _, v in pairs(Holding:GetChildren()) do
                if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                    -- نحتاج نعد كل العناصر، مو بس الأسماك
                    currentItems = currentItems + 1
                end
            end
        end
    end
    
    -- نتحقق إذا المخزون فل
    local isFull = currentItems >= maxSlots
    
    return isFull, currentItems, maxSlots
end
