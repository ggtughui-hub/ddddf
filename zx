    Sf:Teleport(atmPos, true, 20)
    task.wait(0.5)
    
    print("🏦 جاري سحب $" .. needed .. " من البنك...")
    local success = pcall(function()
        Net_upvr.get("transfer_funds", "bank", "hand", needed)
    end)

    if success then
