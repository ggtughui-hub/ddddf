    changeKeyButton.MouseButton1Click:Connect(function()
        if isWaitingForKey then return end
        isWaitingForKey = true
        changeKeyButton.Text = "⌨️ انتظر..."
        qButton.Text = "?"
        
        local connection
        connection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                qButton.Text = tostring(currentKey.Name)
                keyDisplay.Text = "الاختصار الحالي: " .. tostring(currentKey.Name)
                changeKeyButton.Text = "🔄 تعيين"
                isWaitingForKey = false
                connection:Disconnect()
            end
        end)
    end)

