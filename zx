function BuyEquipment()
    local hasRod, currentRodName, currentRodUid, _ = Sf:HasAnyRod()
    local hasBait, currentBaitName, currentBaitUid = Sf:HasAnyBait()
    print("🛒 [BuyEquipment] التحضير للشراء. السنارة الحالية: " .. (currentRodName or "لا شيء") .. ", الطعم الحالي: " .. (currentBaitName or "لا شيء"))

    local Items = PlayerGui:FindFirstChild("Items")
    local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if not Holding then
        print("⚠️ [BuyEquipment] تعذر العثور على إنونتوري، تخطي رمي العناصر.")
    else
        print("🗑️ [BuyEquipment] جاري فحص العناصر لرميها...")
        for _, v in pairs(Holding:GetChildren()) do
            if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                local nameLbl = v:FindFirstChild("ItemName")
                if nameLbl and nameLbl.Text then
                    local itemUid = v.Name
                    local itemName = nameLbl.Text
                    if (hasRod and itemUid == currentRodUid) or (hasBait and itemUid == currentBaitUid) then
                        print("⏭️ [BuyEquipment] تجاهل العنصر المحفوظ: " .. itemName .. " (UID: " .. itemUid .. ")")
                    else
                        print("扔 [BuyEquipment] جاري رمي العنصر: " .. itemName .. " (UID: " .. itemUid .. ")")
                        pcall(function()
                            Net_upvr.get("drop_item", itemUid, 1)
                        end)
                        task.wait(0.1)
                    end
                end
            end
        end
    end

    local selectedRod = RodDropdown.Value
    local selectedBait = BaitDropdown.Value
    local targetBait = BaitAmount.Value
    local fishingLevel = Sf:GetSkill("Fishing")

    local targetRod = selectedRod
    if targetRod == "Smart Select" then
        for _, rod in ipairs(FishingRods) do
            if fishingLevel >= rod.Level then
                targetRod = rod.Name
            end
        end
    end

    local targetBaitName = selectedBait
    if targetBaitName == "Smart Select" then
        for _, bait in ipairs(FishingBaits) do
            if fishingLevel >= bait.Level then
                targetBaitName = bait.Name
            end
        end
    end

    local hasRodAfterDrop, rodNameAfterDrop, rodUidAfterDrop, rodEquippedAfterDrop = Sf:HasAnyRod()
    local hasBaitAfterDrop, baitNameAfterDrop, baitUidAfterDrop = Sf:HasAnyBait()

    local totalCost = 0
    if not hasRodAfterDrop then
        for _, rod in ipairs(FishingRods) do
            if rod.Name == targetRod then
                totalCost = totalCost + rod.Price
                break
            end
        end
    end
    if not hasBaitAfterDrop then
        for _, bait in ipairs(FishingBaits) do
            if bait.Name == targetBaitName then
                totalCost = totalCost + (bait.Price * targetBait)
                break
            end
        end
    end

    if totalCost <= 0 then
        print("✅ [BuyEquipment] المعدات مكتملة (بعد رمي العناصر الزائدة)!")
        return true
    end

    print("💰 [BuyEquipment] التكلفة المطلوبة بعد التنظيف: $" .. totalCost)

    if not WithdrawSpecificAmount(totalCost) then
        return false
    end

    print("📍 [BuyEquipment] التوجه إلى المتجر...")
    Sf:Teleport(ShopLocation, true, 25)
    task.wait(0.5)
    
    local shopFolder = workspace:FindFirstChild("ShopZone_Hardware")
    if not shopFolder then
        warn("❌ [BuyEquipment] لم يتم العثور على ShopZone_Hardware!")
        return false
    end

    print("📦 [BuyEquipment] جاري شراء المعدات...")
    if not hasRodAfterDrop then
        print(" Gunnery [BuyEquipment] جاري شراء السنارة: " .. targetRod)
        pcall(function()
            Net_upvr.get("purchase_consumable", shopFolder, targetRod)
        end)
        task.wait(0.5)
    else
        print("⏭️ [BuyEquipment] السنارة متوفرة بالفعل، تخطي الشراء.")
    end

    if not hasBaitAfterDrop then
        print(" Gunnery [BuyEquipment] جاري شراء " .. targetBait .. " من الطعم: " .. targetBaitName)
        for i = 1, targetBait do
            if not IsFarmingActive then
                break
            end
            pcall(function()
                Net_upvr.get("purchase_consumable", shopFolder, targetBaitName)
            end)
            task.wait(0.1)
        end
    else
        print("⏭️ [BuyEquipment] الطعم متوفر بالفعل، تخطي الشراء.")
    end

    print("✅ [BuyEquipment] اكتملت عملية الشراء!")
    return true
end

