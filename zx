function EquipRod()
    local hasRod, rodName, rodUid, rodEquipped = Sf:HasAnyRod()
    
    if not hasRod or not rodName then
        warn("❌ لا توجد سنارة في الإنونتوري!")
        return false
    end
    
    print(" Gunnery [MainLoop] السنارة الموجودة: " .. rodName .. " (UID: " .. tostring(rodUid) .. ")")
    
    if Sf:IsRodEquipped(rodName) then
        print("✅ السنارة مجهزة بالفعل!")
        return true
    end
    
    print("🔧 جاري تجهيز السنارة...")
    
    local equipSuccess = false
    pcall(function()
        Net_upvr.get("toggle_equip_item", tostring(rodUid))
        equipSuccess = true
    end)
    
    if not equipSuccess then
        warn("❌ فشل في تجهيز السنارة عبر الـ Remote!")
        return false
    end
    
    local timeout = tick() + 5
    while tick() - timeout < 5 do
        if Sf:IsRodEquipped(rodName) then
            print("✅ تم تجهيز السنارة بنجاح!")
            
            local char = Client and Client.Character
            local backpack = Client and Client:FindFirstChild("Backpack")
            if char and backpack then
                local tool = backpack:FindFirstChild(rodName)
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if tool and humanoid then
                    humanoid:EquipTool(tool)
                    task.wait(0.3)
                end
            end
            
            VU:SetKeyDown(Enum.KeyCode.Two)
            task.wait(0.1)
            VU:SetKeyUp(Enum.KeyCode.Two)
            task.wait(0.5)
            
            return true
        end
        task.wait(0.1)
    end
    
    warn("❌ انتهى وقت الانتظار ولم يتم تجهيز السنارة!")
    return false
end

function EnsureRodEquipped()
    local hasRod, rodName, rodUid, rodEquipped = Sf:HasAnyRod()
    
    if not hasRod or not rodName then
        print("⚠️ لا توجد سنارة! جاري إعادة التجهيز...")
        return EquipRod()
    end
    
    if not Sf:IsRodEquipped(rodName) then
        print("⚠️ السنارة غير مجهزة! جاري إعادة التجهيز...")
        return EquipRod()
    end
    
    return true
end

